<%- include('partials/header', { title: 'Daftar Student Staff' }) %>
<%- include('partials/nav', { path: '/student-staff' }) %>

<main class="flex-grow w-full max-w-[1440px] mx-auto px-4 sm:px-6 lg:px-8 py-6 sm:py-12">
    <!-- Page Header -->
    <div class="mb-6 sm:mb-8 animate-fadeInUp flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
            <h2 class="font-display text-2xl sm:text-4xl font-bold text-fg mb-1">Daftar Student & Staff</h2>
            <p class="text-xs sm:text-sm text-muted">Kelola data Student & Staff</p>
        </div>
        <button onclick="openAddModal()" class="px-5 py-2.5 bg-accent text-white font-medium rounded-xl hover:bg-accentHover transition-colors btn-press text-sm inline-flex items-center gap-2">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"/></svg>
            Tambah Data
        </button>
    </div>

    <% if (typeof success_msg !== 'undefined' && success_msg) { %>
        <div class="mb-6 bg-success/20 text-success border border-success/30 px-4 py-3 rounded-xl animate-fadeInUp">
            <%= success_msg %>
        </div>
    <% } %>
    <% if (typeof error_msg !== 'undefined' && error_msg) { %>
        <div class="mb-6 bg-red-500/20 text-red-500 border border-red-500/30 px-4 py-3 rounded-xl animate-fadeInUp">
            <%= error_msg %>
        </div>
    <% } %>

    <!-- Desktop Table Section -->
    <div class="hidden md:block bg-card rounded-2xl border border-border overflow-hidden animate-fadeInUp stagger-1 shadow-sm mb-6">
        <div class="table-container overflow-x-auto">
            <table class="w-full min-w-[600px]">
                <thead class="bg-accentLighter border-b border-border">
                    <tr>
                        <th class="px-4 sm:px-6 py-4 text-left text-xs font-bold text-accent uppercase tracking-wider">No</th>
                        <th class="px-4 sm:px-6 py-4 text-left text-xs font-bold text-accent uppercase tracking-wider">Nama</th>
                        <th class="px-4 sm:px-6 py-4 text-left text-xs font-bold text-accent uppercase tracking-wider">Tipe</th>
                        <th class="px-4 sm:px-6 py-4 text-left text-xs font-bold text-accent uppercase tracking-wider">Role</th>
                        <th class="px-4 sm:px-6 py-4 text-left text-xs font-bold text-accent uppercase tracking-wider">Wajah</th>
                        <th class="px-4 sm:px-6 py-4 text-center text-xs font-bold text-accent uppercase tracking-wider">Aksi</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-border">
                    <% if (karyawanList && karyawanList.length === 0) { %>
                        <tr>
                            <td colspan="6" class="py-10 text-center">
                                <p class="text-muted text-sm">Data tidak ditemukan.</p>
                            </td>
                        </tr>
                    <% } else if (karyawanList) { %>
                        <% karyawanList.forEach((k, i) => { %>
                            <tr class="hover:bg-accentLighter/30 transition-colors">
                                <td class="px-4 sm:px-6 py-4 whitespace-nowrap text-sm text-muted font-medium"><%= i + 1 %></td>
                                <td class="px-4 sm:px-6 py-4 whitespace-nowrap">
                                    <div class="flex items-center gap-3">
                                        <div class="w-9 h-9 rounded-full bg-accentLight flex items-center justify-center text-sm font-bold text-accent flex-shrink-0">
                                            <%= k.nama.split(/\s+/).slice(0,2).map(n=>n[0]).join('').toUpperCase() %>
                                        </div>
                                        <span class="text-sm text-fg font-medium"><%= k.nama %></span>
                                    </div>
                                </td>
                                <td class="px-4 sm:px-6 py-4 whitespace-nowrap text-sm text-fg">
                                    <% if(k.type) { %>
                                        <span class="px-2 py-1 rounded-lg text-xs font-semibold <%= k.type === 'Staf' ? 'bg-accent/10 text-accent' : 'bg-blue-100 text-blue-700' %>"><%= k.type %></span>
                                        <% if(k.type === 'Staf') { %><span class="ml-1 text-[10px] text-muted">(tidak presensi)</span><% } %>
                                    <% } else { %>
                                        <span class="text-muted">-</span>
                                    <% } %>
                                </td>
                                <td class="px-4 sm:px-6 py-4 whitespace-nowrap text-sm text-fg">
                                    <% if(k.role) { %>
                                        <span class="px-2 py-1 rounded-lg bg-accent/10 text-accent text-xs font-semibold"><%= k.role %></span>
                                    <% } else { %>
                                        <span class="text-muted">-</span>
                                    <% } %>
                                </td>
                                <td class="px-4 sm:px-6 py-4 whitespace-nowrap text-sm text-fg">
                                    <% if (k.type === 'Staf') { %>
                                        <span class="text-muted">-</span>
                                    <% } else if (k.face_descriptor) { %>
                                        <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-lg bg-green-50 border border-green-200 text-green-700 text-xs font-semibold">
                                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
                                            Terdaftar
                                        </span>
                                    <% } else { %>
                                        <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-lg bg-gray-50 border border-gray-200 text-muted text-xs font-semibold">
                                            Belum
                                        </span>
                                    <% } %>
                                </td>
                                <td class="px-4 sm:px-6 py-4 whitespace-nowrap text-center">
                                    <div class="flex items-center justify-center gap-2">
                                        <% if (k.type !== 'Staf') { %>
                                            <% if (k.face_descriptor) { %>
                                                <button onclick="deleteFace(<%= k.id %>, '<%= k.nama %>')" class="text-red-400 hover:text-red-600 transition-colors p-1.5 rounded hover:bg-red-50" title="Hapus Wajah Terdaftar">
                                                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7a4 4 0 11-8 0 4 4 0 018 0zM9 20a6 6 0 00-6 0v1h12v-1a6 6 0 00-6-6zm8-4a1 1 0 01-1-1V9a1 1 0 012 0v6a1 1 0 01-1 1zm0 4a1 1 0 100-2 1 1 0 000 2z"/></svg>
                                                </button>
                                            <% } else { %>
                                                <button onclick="openRegisterFaceModal(<%= k.id %>, '<%= k.nama %>')" class="text-muted hover:text-accent transition-colors p-1.5 rounded hover:bg-accentLight/50" title="Daftarkan Wajah">
                                                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"/></svg>
                                                </button>
                                            <% } %>
                                        <% } %>
                                        <button onclick='openEditModal(<%- JSON.stringify(k) %>)' class="text-muted hover:text-indigo-600 transition-colors p-1.5 rounded hover:bg-indigo-50" title="Edit">
                                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
                                        </button>
                                        <button onclick='openDeleteModal(<%- JSON.stringify(k) %>)' class="text-muted hover:text-red-500 transition-colors p-1.5 rounded hover:bg-red-50" title="Hapus">
                                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        <% }) %>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>

    <!-- Mobile Card Section -->
    <div class="md:hidden space-y-4 animate-fadeInUp stagger-1 mb-6">
        <% if (karyawanList && karyawanList.length === 0) { %>
            <div class="bg-card rounded-2xl border border-border p-8 text-center shadow-sm">
                <p class="text-muted text-sm">Data tidak ditemukan.</p>
            </div>
        <% } else if (karyawanList) { %>
            <% karyawanList.forEach(k => { %>
                <div class="bg-card rounded-2xl border border-border p-5 shadow-sm space-y-3">
                    <div class="flex justify-between items-start">
                        <div class="flex items-center gap-3">
                            <div class="w-10 h-10 rounded-full bg-accentLight flex items-center justify-center text-sm font-bold text-accent flex-shrink-0">
                                <%= k.nama.split(/\s+/).slice(0,2).map(n=>n[0]).join('').toUpperCase() %>
                            </div>
                            <div>
                                <h4 class="font-bold text-fg text-sm"><%= k.nama %></h4>
                                <div class="flex gap-2 mt-1 flex-wrap">
                                    <% if(k.type) { %><span class="px-2 py-0.5 rounded text-[11px] font-semibold <%= k.type === 'Staf' ? 'bg-accent/10 text-accent' : 'bg-blue-100 text-blue-700' %>"><%= k.type %></span><% } %>
                                    <% if(k.role) { %><span class="px-2 py-0.5 rounded bg-inputBg text-muted text-[11px] font-semibold"><%= k.role %></span><% } %>
                                    <% if(k.type !== 'Staf') { %>
                                        <% if(k.face_descriptor) { %>
                                            <span class="px-2 py-0.5 rounded bg-green-100 text-green-700 text-[11px] font-semibold flex items-center gap-1">✓ Wajah</span>
                                        <% } else { %>
                                            <span class="px-2 py-0.5 rounded bg-gray-100 text-muted text-[11px] font-semibold flex items-center gap-1">Belum Wajah</span>
                                        <% } %>
                                    <% } %>
                                </div>
                            </div>
                        </div>
                        <div class="flex items-center gap-1">
                            <% if (k.type !== 'Staf') { %>
                                <% if (k.face_descriptor) { %>
                                    <button onclick="deleteFace(<%= k.id %>, '<%= k.nama %>')" class="text-red-400 hover:text-red-600 transition-colors p-2 rounded-lg hover:bg-inputBg" title="Hapus Wajah">
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7a4 4 0 11-8 0 4 4 0 018 0zM9 20a6 6 0 00-6 0v1h12v-1a6 6 0 00-6-6zm8-4a1 1 0 01-1-1V9a1 1 0 012 0v6a1 1 0 01-1 1zm0 4a1 1 0 100-2 1 1 0 000 2z"/></svg>
                                    </button>
                                <% } else { %>
                                    <button onclick="openRegisterFaceModal(<%= k.id %>, '<%= k.nama %>')" class="text-muted hover:text-accent transition-colors p-2 rounded-lg hover:bg-inputBg" title="Daftar Wajah">
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"/></svg>
                                    </button>
                                <% } %>
                            <% } %>
                            <button onclick='openEditModal(<%- JSON.stringify(k) %>)' class="text-muted hover:text-indigo-600 transition-colors p-2 rounded-lg hover:bg-inputBg" title="Edit">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
                            </button>
                            <button onclick='openDeleteModal(<%- JSON.stringify(k) %>)' class="text-muted hover:text-red-500 transition-colors p-2 rounded-lg hover:bg-inputBg" title="Hapus">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                            </button>
                        </div>
                    </div>
                </div>
            <% }) %>
        <% } %>
    </div>
</main>

<!-- Add Modal -->
<div id="addModal" class="fixed inset-0 bg-black/50 z-50 flex items-center justify-center p-4 hidden opacity-0 transition-opacity duration-300">
    <div class="bg-card rounded-2xl p-6 max-w-md w-full shadow-xl transform scale-95 transition-transform duration-300" id="addModalContent">
        <div class="flex items-center justify-between mb-6">
            <h3 class="font-display text-xl font-bold text-fg">Tambah Student Staff</h3>
            <button type="button" onclick="closeAddModal()" class="text-muted hover:text-fg transition-colors">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
            </button>
        </div>
        <form action="/student-staff/add" method="POST" class="space-y-4">
            <div>
                <label class="block text-sm font-semibold text-fg mb-2">Nama Student Staff</label>
                <input type="text" name="nama" required class="w-full px-4 py-2.5 bg-inputBg border border-border rounded-xl text-fg focus:border-accent transition-colors text-sm" placeholder="Masukkan nama lengkap">
            </div>
            <div class="grid grid-cols-2 gap-3">
                <div>
                    <label class="block text-sm font-semibold text-fg mb-2">Tipe</label>
                    <select name="type" class="w-full px-4 py-2.5 bg-inputBg border border-border rounded-xl text-fg appearance-none cursor-pointer focus:border-accent transition-colors text-sm">
                        <option value="">-- Pilih Tipe --</option>
                        <option value="Student Staff">Student Staff</option>
                        <option value="Staf">Staf</option>
                    </select>
                </div>
                <div>
                    <label class="block text-sm font-semibold text-fg mb-2">Role</label>
                    <input type="text" name="role" class="w-full px-4 py-2.5 bg-inputBg border border-border rounded-xl text-fg focus:border-accent transition-colors text-sm" placeholder="Misal: Frontend Dev">
                </div>
            </div>
            <div class="mt-6 pt-4 border-t border-border flex justify-end gap-3">
                <button type="button" onclick="closeAddModal()" class="px-5 py-2.5 bg-inputBg text-muted font-semibold rounded-xl hover:bg-border transition-colors text-sm">Batal</button>
                <button type="submit" class="px-5 py-2.5 bg-accent text-white font-medium rounded-xl hover:bg-accentHover transition-colors text-sm">Simpan</button>
            </div>
        </form>
    </div>
</div>

<!-- Edit Modal -->
<div id="editModal" class="fixed inset-0 bg-black/50 z-50 flex items-center justify-center p-4 hidden opacity-0 transition-opacity duration-300">
    <div class="bg-card rounded-2xl p-6 max-w-md w-full shadow-xl transform scale-95 transition-transform duration-300" id="editModalContent">
        <div class="flex items-center justify-between mb-6">
            <h3 class="font-display text-xl font-bold text-fg">Edit Student Staff</h3>
            <button type="button" onclick="closeEditModal()" class="text-muted hover:text-fg transition-colors">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
            </button>
        </div>
        <form action="/student-staff/edit" method="POST" class="space-y-4">
            <input type="hidden" name="id" id="editId">
            <div>
                <label class="block text-sm font-semibold text-fg mb-2">Nama Student Staff</label>
                <input type="text" name="nama" id="editNama" required class="w-full px-4 py-2.5 bg-inputBg border border-border rounded-xl text-fg focus:border-accent transition-colors text-sm" placeholder="Masukkan nama lengkap">
            </div>
            <div class="grid grid-cols-2 gap-3">
                <div>
                    <label class="block text-sm font-semibold text-fg mb-2">Tipe</label>
                    <select name="type" id="editType" class="w-full px-4 py-2.5 bg-inputBg border border-border rounded-xl text-fg appearance-none cursor-pointer focus:border-accent transition-colors text-sm">
                        <option value="">-- Pilih Tipe --</option>
                        <option value="Student Staff">Student Staff</option>
                        <option value="Staf">Staf</option>
                    </select>
                </div>
                <div>
                    <label class="block text-sm font-semibold text-fg mb-2">Role</label>
                    <input type="text" name="role" id="editRole" class="w-full px-4 py-2.5 bg-inputBg border border-border rounded-xl text-fg focus:border-accent transition-colors text-sm" placeholder="Misal: Frontend Dev">
                </div>
            </div>
            <div class="mt-6 pt-4 border-t border-border flex justify-end gap-3">
                <button type="button" onclick="closeEditModal()" class="px-5 py-2.5 bg-inputBg text-muted font-semibold rounded-xl hover:bg-border transition-colors text-sm">Batal</button>
                <button type="submit" class="px-5 py-2.5 bg-accent text-white font-medium rounded-xl hover:bg-accentHover transition-colors text-sm">Simpan Perubahan</button>
            </div>
        </form>
    </div>
</div>

<!-- Delete Modal -->
<div id="deleteModal" class="fixed inset-0 bg-black/50 z-50 flex items-center justify-center p-4 hidden opacity-0 transition-opacity duration-300">
    <div class="bg-card rounded-2xl p-6 max-w-md w-full shadow-xl transform scale-95 transition-transform duration-300" id="deleteModalContent">
        <div class="flex items-center justify-between mb-4">
            <h3 class="font-display text-xl font-bold text-fg">Konfirmasi Hapus</h3>
            <button type="button" onclick="closeDeleteModal()" class="text-muted hover:text-fg transition-colors">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
            </button>
        </div>
        <p class="text-sm text-muted mb-6">Apakah Anda yakin ingin menghapus data <span id="deleteNama" class="font-bold text-fg"></span>? <br><br><span class="text-red-500 font-semibold">Peringatan:</span> Menghapus data ini juga akan menghapus seluruh data presensi dan overtime yang bersangkutan secara permanen.</p>
        <form action="/student-staff/delete" method="POST">
            <input type="hidden" name="id" id="deleteId">
            <div class="flex justify-end gap-3">
                <button type="button" onclick="closeDeleteModal()" class="px-5 py-2.5 bg-inputBg text-muted font-semibold rounded-xl hover:bg-border transition-colors text-sm">Batal</button>
                <button type="submit" class="px-5 py-2.5 bg-red-500 text-white font-medium rounded-xl hover:bg-red-600 transition-colors text-sm">Ya, Hapus</button>
            </div>
        </form>
    </div>
</div>

<!-- Register Face Modal -->
<div id="registerFaceModal" class="fixed inset-0 bg-black/50 z-50 flex items-center justify-center p-4 hidden opacity-0 transition-opacity duration-300">
    <div class="bg-card rounded-2xl p-6 max-w-lg w-full shadow-xl transform scale-95 transition-transform duration-300" id="registerFaceModalContent">
        <div class="flex items-center justify-between mb-4">
            <h3 class="font-display text-xl font-bold text-fg">Pendaftaran Wajah</h3>
            <button type="button" onclick="closeRegisterFaceModal()" class="text-muted hover:text-fg transition-colors">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
            </button>
        </div>
        <p class="text-sm text-muted mb-4">Mendaftarkan wajah untuk <span id="registerFaceNama" class="font-bold text-fg"></span>. Posisikan wajah Anda tegak lurus di depan kamera.</p>
        
        <!-- Camera Selector -->
        <div id="cameraSelectContainer" class="mb-4 hidden animate-fadeInUp">
            <label class="block text-xs font-semibold text-muted mb-1.5 uppercase tracking-wider">Pilih Kamera / Webcam</label>
            <select id="cameraSelect" class="w-full px-4 py-2.5 bg-inputBg border border-border rounded-xl text-fg appearance-none cursor-pointer focus:border-accent transition-colors text-sm">
            </select>
        </div>

        <!-- Video Feed Container -->
        <div class="relative overflow-hidden rounded-xl border border-border bg-inputBg aspect-video max-w-md mx-auto flex items-center justify-center mb-4">
            <video id="faceRegVideo" autoplay muted playsinline class="w-full h-full object-cover" style="transform: scaleX(-1);"></video>
            <canvas id="faceRegCanvas" class="absolute inset-0 w-full h-full pointer-events-none" style="transform: scaleX(-1);"></canvas>
            <div id="faceRegLoader" class="absolute inset-0 bg-black/75 flex flex-col items-center justify-center text-white p-4 text-center z-10">
                <svg class="w-10 h-10 animate-spin text-accent mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 1121.21 8H18.22"/>
                </svg>
                <p class="text-sm font-medium" id="loaderText">Menginisialisasi kamera & modul AI...</p>
            </div>
        </div>

        <div id="faceRegStatus" class="text-center text-sm font-semibold text-muted py-2 bg-inputBg rounded-xl mb-6">
            Mempersiapkan...
        </div>

        <div class="flex justify-end gap-3 pt-4 border-t border-border">
            <button type="button" onclick="closeRegisterFaceModal()" class="px-5 py-2.5 bg-inputBg text-muted font-semibold rounded-xl hover:bg-border transition-colors text-sm">Batal</button>
            <button type="button" id="saveFaceBtn" disabled onclick="saveFaceDescriptor()" class="px-5 py-2.5 bg-accent disabled:opacity-50 disabled:cursor-not-allowed text-white font-medium rounded-xl hover:bg-accentHover transition-colors text-sm">✓ Simpan Wajah</button>
        </div>
    </div>
</div>

<!-- face-api.js Library from CDN -->
<script src="https://cdn.jsdelivr.net/npm/face-api.js@0.22.2/dist/face-api.min.js"></script>

<script>
    // Add Modal
    const addModal = document.getElementById('addModal');
    const addModalContent = document.getElementById('addModalContent');
    function openAddModal() {
        addModal.classList.remove('hidden');
        setTimeout(() => {
            addModal.classList.remove('opacity-0');
            addModalContent.classList.remove('scale-95');
        }, 10);
    }
    function closeAddModal() {
        addModal.classList.add('opacity-0');
        addModalContent.classList.add('scale-95');
        setTimeout(() => addModal.classList.add('hidden'), 300);
    }

    // Edit Modal
    const editModal = document.getElementById('editModal');
    const editModalContent = document.getElementById('editModalContent');
    function openEditModal(data) {
        document.getElementById('editId').value = data.id;
        document.getElementById('editNama').value = data.nama;
        document.getElementById('editType').value = data.type || '';
        document.getElementById('editRole').value = data.role || '';
        
        editModal.classList.remove('hidden');
        setTimeout(() => {
            editModal.classList.remove('opacity-0');
            editModalContent.classList.remove('scale-95');
        }, 10);
    }
    function closeEditModal() {
        editModal.classList.add('opacity-0');
        editModalContent.classList.add('scale-95');
        setTimeout(() => editModal.classList.add('hidden'), 300);
    }

    // Delete Modal
    const deleteModal = document.getElementById('deleteModal');
    const deleteModalContent = document.getElementById('deleteModalContent');
    function openDeleteModal(data) {
        document.getElementById('deleteId').value = data.id;
        document.getElementById('deleteNama').textContent = data.nama;
        
        deleteModal.classList.remove('hidden');
        setTimeout(() => {
            deleteModal.classList.remove('opacity-0');
            deleteModalContent.classList.remove('scale-95');
        }, 10);
    }
    function closeDeleteModal() {
        deleteModal.classList.add('opacity-0');
        deleteModalContent.classList.add('scale-95');
        setTimeout(() => deleteModal.classList.add('hidden'), 300);
    }

    // --- FACE REGISTRATION LOGIC ---
    const regModal = document.getElementById('registerFaceModal');
    const regModalContent = document.getElementById('registerFaceModalContent');
    const regVideo = document.getElementById('faceRegVideo');
    const regCanvas = document.getElementById('faceRegCanvas');
    const regStatus = document.getElementById('faceRegStatus');
    const regLoader = document.getElementById('faceRegLoader');
    const saveFaceBtn = document.getElementById('saveFaceBtn');
    const cameraSelectContainer = document.getElementById('cameraSelectContainer');
    const cameraSelect = document.getElementById('cameraSelect');
    
    let regStream = null;
    let regInterval = null;
    let registeredKaryawanId = null;
    let latestDescriptor = null;
    let modelsLoaded = false;

    async function loadFaceRegModels() {
        if (modelsLoaded) return;
        document.getElementById('loaderText').textContent = 'Memuat modul AI Face Recognition...';
        // Load tiny_face_detector, face_landmark_68, and face_recognition models
        await faceapi.nets.tinyFaceDetector.loadFromUri('/models');
        await faceapi.nets.faceLandmark68Net.loadFromUri('/models');
        await faceapi.nets.faceRecognitionNet.loadFromUri('/models');
        modelsLoaded = true;
    }

    async function startRegCamera(deviceId = null) {
        try {
            stopScanning();
            
            if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia) {
                throw new TypeError('NotSecureContextOrUnsupported');
            }

            const videoConstraints = deviceId 
                ? { deviceId: { exact: deviceId }, width: 640, height: 480 }
                : { facingMode: 'user', width: 640, height: 480 };

            regLoader.classList.remove('hidden');
            document.getElementById('loaderText').textContent = 'Menginisialisasi kamera...';

            regStream = await navigator.mediaDevices.getUserMedia({
                video: videoConstraints,
                audio: false
            });
            regVideo.srcObject = regStream;
            
            regVideo.onloadedmetadata = async () => {
                regLoader.classList.add('hidden');
                startScanning();
                await updateCameraList();
            };
        } catch (camErr) {
            console.error('Camera access error:', camErr);
            let errMsg = 'Gagal mengakses kamera. ';
            if (camErr.message === 'NotSecureContextOrUnsupported') {
                errMsg += 'Browser memblokir akses karena website diakses secara tidak aman (HTTP). Silakan gunakan localhost atau koneksi HTTPS.';
            } else if (camErr.name === 'NotAllowedError' || camErr.name === 'PermissionDeniedError') {
                errMsg += 'Izin kamera ditolak/diblokir oleh browser. Silakan klik ikon gembok di sebelah URL bar browser untuk mengaktifkan izin kamera.';
            } else if (camErr.name === 'NotFoundError' || camErr.name === 'DevicesNotFoundError') {
                errMsg += 'Tidak ada perangkat kamera yang terdeteksi. Hubungkan webcam terlebih dahulu.';
            } else if (camErr.name === 'NotReadableError' || camErr.name === 'TrackStartError') {
                errMsg += 'Kamera sedang digunakan oleh aplikasi lain (seperti Zoom, OBS, atau tab browser lain). Harap tutup aplikasi tersebut.';
            } else {
                errMsg += `Error: ${camErr.name || camErr.message || camErr}`;
            }
            regStatus.textContent = errMsg;
            document.getElementById('loaderText').textContent = 'Kamera tidak dapat diakses.';
        }
    }

    async function updateCameraList() {
        try {
            const devices = await navigator.mediaDevices.enumerateDevices();
            const videoDevices = devices.filter(device => device.kind === 'videoinput');
            
            if (videoDevices.length > 1) {
                cameraSelectContainer.classList.remove('hidden');
                cameraSelect.innerHTML = '';
                
                const activeTrack = regStream ? regStream.getVideoTracks()[0] : null;
                const activeSettings = activeTrack ? activeTrack.getSettings() : null;
                const activeDeviceId = activeSettings ? activeSettings.deviceId : null;

                videoDevices.forEach((device, index) => {
                    const opt = document.createElement('option');
                    opt.value = device.deviceId;
                    opt.textContent = device.label || `Kamera ${index + 1}`;
                    if (device.deviceId === activeDeviceId) {
                        opt.selected = true;
                    }
                    cameraSelect.appendChild(opt);
                });

                cameraSelect.onchange = async () => {
                    const selectedId = cameraSelect.value;
                    await startRegCamera(selectedId);
                };
            } else {
                cameraSelectContainer.classList.add('hidden');
            }
        } catch (e) {
            console.warn('Gagal membaca daftar kamera:', e);
        }
    }

    async function openRegisterFaceModal(id, nama) {
        registeredKaryawanId = id;
        document.getElementById('registerFaceNama').textContent = nama;
        
        regModal.classList.remove('hidden');
        setTimeout(() => {
            regModal.classList.remove('opacity-0');
            regModalContent.classList.remove('scale-95');
        }, 10);
        
        regLoader.classList.remove('hidden');
        saveFaceBtn.disabled = true;
        latestDescriptor = null;
        
        try {
            await loadFaceRegModels();
        } catch (modelErr) {
            console.error('Face models loading error:', modelErr);
            regStatus.textContent = 'Gagal memuat modul AI Face Recognition. Error: ' + modelErr.message;
            document.getElementById('loaderText').textContent = 'AI Model Error.';
            return;
        }

        await startRegCamera();
    }

    function closeRegisterFaceModal() {
        stopScanning();
        if (cameraSelectContainer) cameraSelectContainer.classList.add('hidden');
        if (cameraSelect) cameraSelect.innerHTML = '';
        regModal.classList.add('opacity-0');
        regModalContent.classList.add('scale-95');
        setTimeout(() => regModal.classList.add('hidden'), 300);
    }

    function startScanning() {
        regInterval = setInterval(async () => {
            if (!regStream) return;
            
            const options = new faceapi.TinyFaceDetectorOptions({ inputSize: 224, scoreThreshold: 0.5 });
            const detection = await faceapi.detectSingleFace(regVideo, options)
                                         .withFaceLandmarks()
                                         .withFaceDescriptor();
            
            const ctx = regCanvas.getContext('2d');
            const displaySize = { width: regVideo.videoWidth, height: regVideo.videoHeight };
            faceapi.matchDimensions(regCanvas, displaySize);
            ctx.clearRect(0, 0, regCanvas.width, regCanvas.height);
            
            if (detection) {
                const resized = faceapi.resizeResults(detection, displaySize);
                faceapi.draw.drawDetections(regCanvas, resized);
                
                regStatus.innerHTML = '<span class="text-green-600 font-semibold">✓ Wajah terdeteksi! Tahan posisi Anda</span>';
                saveFaceBtn.disabled = false;
                latestDescriptor = Array.from(detection.descriptor);
            } else {
                regStatus.textContent = 'Mencari wajah Anda... Posisikan wajah di tengah kamera';
                saveFaceBtn.disabled = true;
            }
        }, 300);
    }

    function stopScanning() {
        if (regInterval) {
            clearInterval(regInterval);
            regInterval = null;
        }
        if (regStream) {
            regStream.getTracks().forEach(track => track.stop());
            regStream = null;
        }
        regVideo.srcObject = null;
    }

    async function saveFaceDescriptor() {
        if (!registeredKaryawanId || !latestDescriptor) return;
        
        saveFaceBtn.disabled = true;
        saveFaceBtn.textContent = 'Menyimpan...';
        
        try {
            const res = await fetch(`/api/karyawan/${registeredKaryawanId}/register-face`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ descriptor: latestDescriptor })
            });
            
            const data = await res.json();
            if (data.success) {
                alert('Wajah berhasil didaftarkan!');
                window.location.reload();
            } else {
                alert('Gagal mendaftarkan wajah: ' + (data.error || 'Terjadi kesalahan'));
                saveFaceBtn.disabled = false;
                saveFaceBtn.textContent = '✓ Simpan Wajah';
            }
        } catch (e) {
            console.error('Fetch error:', e);
            alert('Gagal menyambung ke server.');
            saveFaceBtn.disabled = false;
            saveFaceBtn.textContent = '✓ Simpan Wajah';
        }
    }

    async function deleteFace(id, nama) {
        if (!confirm(`Apakah Anda yakin ingin menghapus data wajah terdaftar untuk ${nama}?`)) return;
        
        try {
            const res = await fetch(`/api/karyawan/${id}/delete-face`, { method: 'POST' });
            const data = await res.json();
            if (data.success) {
                alert('Data wajah berhasil dihapus.');
                window.location.reload();
            } else {
                alert('Gagal menghapus data wajah: ' + (data.error || 'Terjadi kesalahan'));
            }
        } catch (e) {
            console.error(e);
            alert('Gagal menyambung ke server.');
        }
    }
</script>

