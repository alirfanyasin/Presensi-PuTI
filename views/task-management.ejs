    // ---- Context Menu ----
    let _ctxTask = null;

    function showContextMenu(x, y, task) {
        _ctxTask = task;
        const menu = document.getElementById('contextMenu');
        menu.classList.remove('hidden');
        // Position - keep within viewport
        const menuW = 180, menuH = 100;
        const vpW = window.innerWidth, vpH = window.innerHeight;
        menu.style.left = (x + menuW > vpW ? x - menuW : x) + 'px';
        menu.style.top  = (y + menuH > vpH ? y - menuH : y) + 'px';
    }

    function hideContextMenu() {
        document.getElementById('contextMenu').classList.add('hidden');
        _ctxTask = null;
    }

    document.addEventListener('click', hideContextMenu);
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') hideContextMenu(); });
    document.addEventListener('contextmenu', (e) => {
        // Hide if clicking outside a table row
        if (!e.target.closest('#listTableBody tr')) hideContextMenu();
    });

    document.addEventListener('DOMContentLoaded', () => {
        const pendingVoice = sessionStorage.getItem('pendingVoice');
        if (pendingVoice) {
            playVoiceAnnouncement(pendingVoice);
            sessionStorage.removeItem('pendingVoice');
        } else {
            const urlParams = new URLSearchParams(window.location.search);
            const successStatus = urlParams.get('success');
            const taskIdParam = urlParams.get('taskId');
            const assigneesChanged = urlParams.get('assigneesChanged');

            if (successStatus && taskIdParam) {
                const changedTask = allTasks.find(t => t.id == taskIdParam);
                if (changedTask && changedTask.assignees) {
                    if (successStatus === 'added') {
                        playVoiceAnnouncement(`Tugas baru untuk ${changedTask.assignees} dengan kode ${changedTask.code}`);
                    } else if (successStatus === 'edited' && assigneesChanged === 'true') {
                        playVoiceAnnouncement(`Tugas dengan kode ${changedTask.code} diperbarui penugasannya ke ${changedTask.assignees}`);
                    }
                }
                window.history.replaceState({}, document.title, window.location.pathname);
            }
        }
    });
</script>

