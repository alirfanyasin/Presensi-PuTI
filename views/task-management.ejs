<%- include('partials/header', { title: 'Task Management - Service Desk' }) %>
<%- include('partials/nav', { path: '/task-management' }) %>

<script src="https://cdn.jsdelivr.net/npm/sortablejs@latest/Sortable.min.js"></script>

<style>
    /* Additional styles for Kanban and Animations */
    .kanban-col {
        min-height: 500px;
        transition: background-color 0.2s ease;
    }
    .task-card {
        cursor: grab;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }
    .task-card:active {
        cursor: grabbing;
    }
    .sortable-ghost {
        opacity: 0.4;
        background-color: #f3f4f6;
    }
    
    /* Workspace Tab active state */
    .workspace-tab.active {
        background-color: var(--accent);
        color: white;
        border-color: var(--accent);
    }
    
    .view-toggle.active {
        background-color: var(--accent);
        color: white;
    }
    
    /* Avatar active state for checkboxes */
    .avatar-cb:checked + div {
        border-color: var(--accent);
        box-shadow: 0 0 0 2px rgba(var(--accent-rgb), 0.3);
    }

    /* Lightbox */
    #lightbox {
        backdrop-filter: blur(4px);
    }

    /* Context Menu */
    #contextMenu {
        animation: ctxFadeIn 0.12s ease;
        min-width: 160px;
    }
    @keyframes ctxFadeIn {
        from { opacity: 0; transform: scale(0.95) translateY(-4px); }
        to   { opacity: 1; transform: scale(1)   translateY(0); }
    }
    .ctx-item {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 8px 14px;
        font-size: 0.8125rem;
        font-weight: 500;
        cursor: pointer;
        transition: background 0.12s;
        border-radius: 6px;
    }
    .ctx-item:hover { background: var(--inputBg); }
    .ctx-item.danger { color: #ef4444; }
    .ctx-item.danger:hover { background: #fef2f2; }
</style>

<main class="flex-grow w-full max-w-[1440px] mx-auto px-4 sm:px-6 lg:px-8 py-6 sm:py-12">
    <!-- Page Header -->
    <div class="mb-6 sm:mb-8 animate-fadeInUp flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
            <h2 class="font-display text-2xl sm:text-4xl font-bold text-fg mb-1">Service Desk</h2>
            <p class="text-xs sm:text-sm text-muted">Kelola dan delegasikan tugas Student Staff secara terorganisir</p>
        </div>
        <div class="flex gap-2 flex-wrap">
            <button onclick="openWsModal()" class="px-4 py-2.5 bg-inputBg text-fg font-medium rounded-xl hover:bg-border transition-colors text-sm border border-border shadow-sm flex items-center gap-2">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
                Kelola Workspace
            </button>
            <button onclick="openAddModal()" class="px-5 py-2.5 bg-accent text-white font-medium rounded-xl hover:bg-accentHover transition-colors btn-press text-sm inline-flex items-center gap-2 shadow-sm">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"/></svg>
                Tambah Tiket
            </button>
        </div>
    </div>

    <!-- Metrics Dashboard Panel -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6 animate-fadeInUp">
        <div class="bg-card border border-border rounded-2xl p-4 shadow-sm flex flex-col">
            <span class="text-muted text-xs font-bold uppercase tracking-wider mb-1">Total Tiket</span>
            <span class="text-2xl font-bold text-fg" id="metricTotal">0</span>
        </div>
        <div class="bg-card border border-border rounded-2xl p-4 shadow-sm flex flex-col">
            <span class="text-amber-600 text-xs font-bold uppercase tracking-wider mb-1">Todo</span>
            <span class="text-2xl font-bold text-fg" id="metricTodo">0</span>
        </div>
        <div class="bg-card border border-border rounded-2xl p-4 shadow-sm flex flex-col">
            <span class="text-blue-600 text-xs font-bold uppercase tracking-wider mb-1">On Progress</span>
            <span class="text-2xl font-bold text-fg" id="metricProgress">0</span>
        </div>
        <div class="bg-card border border-border rounded-2xl p-4 shadow-sm flex flex-col relative overflow-hidden">
            <span class="text-green-600 text-xs font-bold uppercase tracking-wider mb-1">Selesai</span>
            <div class="flex items-end justify-between">
                <span class="text-2xl font-bold text-fg" id="metricDone">0</span>
                <span class="text-sm font-bold text-green-500" id="metricDoneRate">0%</span>
            </div>
            <!-- Progress bar bg -->
            <div class="absolute bottom-0 left-0 h-1 bg-green-500 transition-all duration-500" id="metricDoneBar" style="width: 0%"></div>
        </div>
    </div>

    <!-- Controls Row: Workspaces & View Toggle -->
    <div class="flex flex-col xl:flex-row gap-4 justify-between items-start xl:items-center mb-6 animate-fadeInUp">
        <!-- Workspace Tabs -->
        <div class="flex overflow-x-auto hide-scrollbar w-full xl:w-auto gap-2 pb-2 xl:pb-0" id="workspaceTabs">
            <% if(workspaces && workspaces.length > 0) { %>
                <% workspaces.forEach((ws, idx) => { %>
                    <button onclick="setWorkspace('<%= ws.nama %>')" class="workspace-tab whitespace-nowrap px-4 py-2 rounded-xl border border-border bg-card text-fg font-medium text-sm transition-colors" data-ws="<%= ws.nama %>"><%= ws.nama %></button>
                <% }) %>
            <% } %>
        </div>

        <!-- View Toggle & Search -->
        <div class="flex w-full xl:w-auto gap-3 items-center flex-wrap xl:flex-nowrap">
            <div class="relative flex-grow xl:flex-grow-0 xl:w-64">
                <span class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-muted">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
                </span>
                <input type="text" id="searchInput" oninput="applyFilters()" class="w-full pl-9 pr-4 py-2 bg-card border border-border rounded-xl text-fg focus:border-accent transition-colors text-sm" placeholder="Cari tiket...">
            </div>
            <div class="flex bg-card border border-border rounded-xl overflow-hidden shadow-sm flex-shrink-0">
                <button onclick="setViewMode('list')" id="btnViewList" class="view-toggle px-4 py-2 text-sm font-medium text-fg hover:bg-inputBg transition-colors border-r border-border flex items-center gap-2">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 10h16M4 14h16M4 18h16"/></svg>
                    List
                </button>
                <button onclick="setViewMode('kanban')" id="btnViewKanban" class="view-toggle px-4 py-2 text-sm font-medium text-fg hover:bg-inputBg transition-colors flex items-center gap-2 active">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17V7m0 10a2 2 0 01-2 2H5a2 2 0 01-2-2V7a2 2 0 012-2h2a2 2 0 012 2m0 10a2 2 0 002 2h2a2 2 0 002-2M9 7a2 2 0 012-2h2a2 2 0 012 2m0 10V7m0 10a2 2 0 002 2h2a2 2 0 002-2V7a2 2 0 00-2-2h-2a2 2 0 00-2 2"/></svg>
                    Kanban
                </button>
            </div>
        </div>
    </div>

    <!-- MAIN RENDER AREA -->
    
    <!-- KANBAN BOARD VIEW -->
    <div id="viewKanban" class="animate-fadeInUp">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            <!-- Todo Column -->
            <div class="flex flex-col bg-card/50 border border-border rounded-2xl p-4 kanban-col" data-status="Todo">
                <div class="flex items-center justify-between mb-4 pb-2 border-b border-border">
                    <div class="flex items-center gap-2">
                        <div class="w-3 h-3 rounded-full bg-amber-500"></div>
                        <h3 class="font-bold text-fg">Todo</h3>
                    </div>
                    <span class="bg-inputBg text-muted text-xs font-bold px-2 py-1 rounded-lg" id="countTodo">0</span>
                </div>
                <div class="flex flex-col gap-3 min-h-[100px]" id="colTodo"></div>
            </div>

            <!-- On Progress Column -->
            <div class="flex flex-col bg-card/50 border border-border rounded-2xl p-4 kanban-col" data-status="On Progress">
                <div class="flex items-center justify-between mb-4 pb-2 border-b border-border">
                    <div class="flex items-center gap-2">
                        <div class="w-3 h-3 rounded-full bg-blue-500"></div>
                        <h3 class="font-bold text-fg">On Progress</h3>
                    </div>
                    <span class="bg-inputBg text-muted text-xs font-bold px-2 py-1 rounded-lg" id="countProgress">0</span>
                </div>
                <div class="flex flex-col gap-3 min-h-[100px]" id="colProgress"></div>
            </div>

            <!-- Done Column -->
            <div class="flex flex-col bg-card/50 border border-border rounded-2xl p-4 kanban-col" data-status="Done">
                <div class="flex items-center justify-between mb-4 pb-2 border-b border-border">
                    <div class="flex items-center gap-2">
                        <div class="w-3 h-3 rounded-full bg-green-500"></div>
                        <h3 class="font-bold text-fg">Done</h3>
                    </div>
                    <span class="bg-inputBg text-muted text-xs font-bold px-2 py-1 rounded-lg" id="countDone">0</span>
                </div>
                <div class="flex flex-col gap-3 min-h-[100px]" id="colDone"></div>
            </div>
        </div>
    </div>

    <!-- LIST VIEW -->
    <div id="viewList" class="hidden animate-fadeInUp">
        <div class="bg-card rounded-2xl border border-border overflow-hidden shadow-sm mb-6">
            <div class="overflow-x-auto">
                <table class="w-full min-w-[1000px]">
                    <thead class="bg-accentLighter border-b border-border">
                        <tr>
                            <th class="px-6 py-4 text-left text-xs font-bold text-accent uppercase tracking-wider">Tiket</th>
                            <th class="px-6 py-4 text-left text-xs font-bold text-accent uppercase tracking-wider">Workspace</th>
                            <th class="px-6 py-4 text-left text-xs font-bold text-accent uppercase tracking-wider">Pemohon</th>
                            <th class="px-6 py-4 text-left text-xs font-bold text-accent uppercase tracking-wider">Deadline</th>
                            <th class="px-6 py-4 text-left text-xs font-bold text-accent uppercase tracking-wider">Prioritas</th>
                            <th class="px-6 py-4 text-left text-xs font-bold text-accent uppercase tracking-wider">Status</th>
                            <th class="px-6 py-4 text-left text-xs font-bold text-accent uppercase tracking-wider">Assignee</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-border" id="listTableBody">
                    </tbody>
                </table>
            </div>
            <div class="flex items-center justify-between px-6 py-3 bg-card border-t border-border">
                <div class="text-sm text-muted">
                    Menampilkan <span class="font-bold text-fg" id="pageStart">0</span> - <span class="font-bold text-fg" id="pageEnd">0</span> dari <span class="font-bold text-fg" id="totalCount">0</span> data
                </div>
                <div class="flex gap-2" id="paginationControls"></div>
            </div>
        </div>
    </div>

</main>

<!-- Kelola Workspace Modal -->
<div id="wsModal" class="fixed inset-0 bg-black/50 z-[60] flex items-center justify-center p-4 hidden opacity-0 transition-opacity duration-300">
    <div class="bg-card rounded-2xl p-6 max-w-lg w-full shadow-xl transform scale-95 transition-transform duration-300" id="wsModalContent">
        <div class="flex items-center justify-between mb-4 border-b border-border pb-4">
            <h3 class="font-display text-xl font-bold text-fg">Kelola Workspace</h3>
            <button type="button" onclick="closeWsModal()" class="text-muted hover:text-fg transition-colors">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
            </button>
        </div>
        
        <div class="max-h-60 overflow-y-auto mb-6 pr-2">
            <% if(workspaces && workspaces.length > 0) { %>
                <ul class="space-y-2">
                <% workspaces.forEach(ws => { %>
                    <li class="flex items-center justify-between p-3 bg-inputBg border border-border rounded-xl">
                        <span class="text-sm font-semibold text-fg"><%= ws.nama %></span>
                        <% if(ws.nama !== 'General') { %>
                        <form action="/workspaces/delete" method="POST" class="inline" onsubmit="return confirm('Hapus workspace ini? Tiket di dalamnya akan dipindah ke General.');">
                            <input type="hidden" name="id" value="<%= ws.id %>">
                            <button type="submit" class="text-red-500 hover:text-red-600 p-1 bg-white rounded shadow-sm border border-border hover:bg-red-50">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                            </button>
                        </form>
                        <% } %>
                    </li>
                <% }) %>
                </ul>
            <% } else { %>
                <p class="text-sm text-muted">Belum ada workspace.</p>
            <% } %>
        </div>

        <form action="/workspaces/add" method="POST" class="border-t border-border pt-4">
            <label class="block text-sm font-semibold text-fg mb-2">Tambah Workspace Baru</label>
            <div class="flex gap-2">
                <input type="text" name="nama" required class="flex-grow px-4 py-2 bg-inputBg border border-border rounded-xl text-fg focus:border-accent text-sm" placeholder="Nama workspace...">
                <button type="submit" class="px-4 py-2 bg-accent text-white font-medium rounded-xl hover:bg-accentHover transition-colors text-sm">Tambah</button>
            </div>
        </form>
    </div>
</div>

<!-- Add Modal -->
<div id="addModal" class="fixed inset-0 bg-black/50 z-50 flex items-center justify-center p-4 hidden opacity-0 transition-opacity duration-300 overflow-y-auto">
    <div class="bg-card rounded-2xl p-6 max-w-2xl w-full shadow-xl transform scale-95 transition-transform duration-300 my-auto" id="addModalContent">
        <div class="flex items-center justify-between mb-6 border-b border-border pb-4">
            <h3 class="font-display text-xl font-bold text-fg">Tambah Tiket Service Desk</h3>
            <button type="button" onclick="closeAddModal()" class="text-muted hover:text-fg transition-colors">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
            </button>
        </div>
        <form action="/task-management/add" method="POST" class="space-y-4">
            
            <div class="grid grid-cols-2 gap-4">
                <div>
                    <label class="block text-sm font-semibold text-fg mb-2">Workspace</label>
                    <select name="workspace" id="addWorkspaceSelect" required class="w-full px-4 py-2.5 bg-inputBg border border-border rounded-xl text-fg appearance-none cursor-pointer focus:border-accent transition-colors text-sm">
                        <% if(workspaces && workspaces.length > 0) { %>
                            <% workspaces.forEach(ws => { %>
                                <option value="<%= ws.nama %>"><%= ws.nama %></option>
                            <% }) %>
                        <% } %>
                    </select>
                </div>
                <div>
                    <label class="block text-sm font-semibold text-fg mb-2">Pemohon / Requester</label>
                    <input type="text" name="requester" class="w-full px-4 py-2.5 bg-inputBg border border-border rounded-xl text-fg focus:border-accent transition-colors text-sm" placeholder="Nama dosen/mahasiswa">
                </div>
            </div>

            <div>
                <label class="block text-sm font-semibold text-fg mb-2">Tugas / Masalah</label>
                <textarea name="task" required rows="3" class="w-full px-4 py-2.5 bg-inputBg border border-border rounded-xl text-fg focus:border-accent transition-colors text-sm resize-none" placeholder="Deskripsikan masalah atau tugas secara detail..."></textarea>
            </div>

            <div class="grid grid-cols-2 gap-4">
                <div>
                    <label class="block text-sm font-semibold text-fg mb-2">Prioritas</label>
                    <select name="priority" required class="w-full px-4 py-2.5 bg-inputBg border border-border rounded-xl text-fg appearance-none cursor-pointer focus:border-accent transition-colors text-sm">
                        <option value="Low">Rendah (Low)</option>
                        <option value="Medium">Sedang (Medium)</option>
                        <option value="High">Tinggi (High)</option>
                        <option value="Critical">Kritis (Critical)</option>
                    </select>
                </div>
                <div>
                    <label class="block text-sm font-semibold text-fg mb-2">Sumber Laporan</label>
                    <select name="source" required class="w-full px-4 py-2.5 bg-inputBg border border-border rounded-xl text-fg appearance-none cursor-pointer focus:border-accent transition-colors text-sm">
                        <option value="Sistem">Sistem / Web</option>
                        <option value="WhatsApp">WhatsApp</option>
                        <option value="Langsung">Datang Langsung</option>
                    </select>
                </div>
            </div>

            <div class="grid grid-cols-2 gap-4 border-t border-border pt-4">
                <div>
                    <label class="block text-sm font-semibold text-fg mb-2">Tanggal Mulai</label>
                    <input type="date" name="tanggal" required class="w-full px-4 py-2.5 bg-inputBg border border-border rounded-xl text-fg focus:border-accent transition-colors text-sm">
                </div>
                <div>
                    <label class="block text-sm font-semibold text-fg mb-2">Deadline</label>
                    <input type="date" name="deadline" required class="w-full px-4 py-2.5 bg-inputBg border border-border rounded-xl text-fg focus:border-accent transition-colors text-sm">
                </div>
            </div>
            
            <div class="grid grid-cols-3 gap-4">
                <div>
                    <label class="block text-sm font-semibold text-fg mb-2">Status</label>
                    <select name="status" required class="w-full px-4 py-2.5 bg-inputBg border border-border rounded-xl text-fg appearance-none cursor-pointer focus:border-accent transition-colors text-sm">
                        <option value="Todo" selected>Todo</option>
                        <option value="On Progress">On Progress</option>
                        <option value="Done">Done</option>
                    </select>
                </div>
                <div>
                    <label class="block text-sm font-semibold text-fg mb-2">Lampiran (Foto)</label>
                    <input type="file" id="addFotoInput" accept="image/*" class="w-full text-sm text-fg file:mr-4 file:py-2.5 file:px-4 file:rounded-xl file:border-0 file:text-sm file:font-semibold file:bg-accentLight file:text-accent hover:file:bg-accent/20 cursor-pointer">
                    <input type="hidden" name="foto" id="addFotoBase64">
                </div>
                <div>
                    <label class="block text-sm font-semibold text-fg mb-2">Lampiran Link</label>
                    <input type="url" name="link" class="w-full px-4 py-2.5 bg-inputBg border border-border rounded-xl text-fg focus:border-accent transition-colors text-sm" placeholder="https://...">
                </div>
            </div>
            
            <div>
                <label class="block text-sm font-semibold text-fg mb-2 mt-4">Assign Student Staff</label>
                <div class="flex flex-wrap gap-3 max-h-36 overflow-y-auto p-3 bg-inputBg border border-border rounded-xl hide-scrollbar">
                    <% if (karyawanList && karyawanList.length > 0) { %>
                        <% karyawanList.forEach(k => { %>
                            <label class="cursor-pointer relative group flex items-center justify-center">
                                <input type="checkbox" name="assignees" value="<%= k.id %>" class="hidden avatar-cb">
                                <div class="w-10 h-10 rounded-full bg-accentLight text-accent flex items-center justify-center text-sm font-bold border-2 border-transparent transition-all shadow-sm" title="<%= k.nama %>">
                                    <%= k.nama.split(/\s+/).slice(0,2).map(n=>n[0]).join('').toUpperCase() %>
                                </div>
                                <div class="absolute bottom-full mb-2 hidden group-hover:block whitespace-nowrap bg-gray-800 text-white text-xs px-2 py-1 rounded shadow-lg z-10"><%= k.nama %></div>
                            </label>
                        <% }) %>
                    <% } else { %>
                        <p class="text-xs text-muted text-center py-2 w-full">Belum ada student staff.</p>
                    <% } %>
                </div>
            </div>
            
            <div class="mt-6 pt-4 border-t border-border flex justify-end gap-3">
                <button type="button" onclick="closeAddModal()" class="px-5 py-2.5 bg-inputBg text-muted font-semibold rounded-xl hover:bg-border transition-colors text-sm">Batal</button>
                <button type="submit" class="px-5 py-2.5 bg-accent text-white font-medium rounded-xl hover:bg-accentHover transition-colors text-sm">Buat Tiket</button>
            </div>
        </form>
    </div>
</div>

<!-- Edit Modal -->
<div id="editModal" class="fixed inset-0 bg-black/50 z-50 flex items-center justify-center p-4 hidden opacity-0 transition-opacity duration-300 overflow-y-auto">
    <div class="bg-card rounded-2xl p-6 max-w-2xl w-full shadow-xl transform scale-95 transition-transform duration-300 my-auto" id="editModalContent">
        <div class="flex items-center justify-between mb-6 border-b border-border pb-4">
            <h3 class="font-display text-xl font-bold text-fg">Edit Tiket</h3>
            <button type="button" onclick="closeEditModal()" class="text-muted hover:text-fg transition-colors">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
            </button>
        </div>
        <form action="/task-management/edit" method="POST" class="space-y-4">
            <input type="hidden" name="id" id="editId">
            <div class="grid grid-cols-2 gap-4">
                <div>
                    <label class="block text-sm font-semibold text-fg mb-2">Workspace</label>
                    <select name="workspace" id="editWorkspace" required class="w-full px-4 py-2.5 bg-inputBg border border-border rounded-xl text-fg appearance-none cursor-pointer focus:border-accent transition-colors text-sm">
                        <% if(workspaces && workspaces.length > 0) { %>
                            <% workspaces.forEach(ws => { %>
                                <option value="<%= ws.nama %>"><%= ws.nama %></option>
                            <% }) %>
                        <% } %>
                    </select>
                </div>
                <div>
                    <label class="block text-sm font-semibold text-fg mb-2">Pemohon / Requester</label>
                    <input type="text" name="requester" id="editRequester" class="w-full px-4 py-2.5 bg-inputBg border border-border rounded-xl text-fg focus:border-accent transition-colors text-sm">
