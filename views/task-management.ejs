            </div>

            <div>
                <label class="block text-sm font-semibold text-fg mb-2">Tugas / Masalah</label>
                <textarea name="task" id="editTaskDesc" required rows="3" class="w-full px-4 py-2.5 bg-inputBg border border-border rounded-xl text-fg focus:border-accent transition-colors text-sm resize-none"></textarea>
            </div>

            <div class="grid grid-cols-2 gap-4">
                <div>
                    <label class="block text-sm font-semibold text-fg mb-2">Prioritas</label>
                    <select name="priority" id="editPriority" required class="w-full px-4 py-2.5 bg-inputBg border border-border rounded-xl text-fg appearance-none cursor-pointer focus:border-accent transition-colors text-sm">
                        <option value="Low">Rendah (Low)</option>
                        <option value="Medium">Sedang (Medium)</option>
                        <option value="High">Tinggi (High)</option>
                        <option value="Critical">Kritis (Critical)</option>
                    </select>
                </div>
                <div>
                    <label class="block text-sm font-semibold text-fg mb-2">Sumber Laporan</label>
                    <select name="source" id="editSource" required class="w-full px-4 py-2.5 bg-inputBg border border-border rounded-xl text-fg appearance-none cursor-pointer focus:border-accent transition-colors text-sm">
                        <option value="Sistem">Sistem / Web</option>
                        <option value="WhatsApp">WhatsApp</option>
                        <option value="Langsung">Datang Langsung</option>
                    </select>
                </div>
            </div>

            <div class="grid grid-cols-2 gap-4 border-t border-border pt-4">
                <div>
                    <label class="block text-sm font-semibold text-fg mb-2">Tanggal Mulai</label>
                    <input type="date" name="tanggal" id="editTanggal" required class="w-full px-4 py-2.5 bg-inputBg border border-border rounded-xl text-fg focus:border-accent transition-colors text-sm">
                </div>
                <div>
                    <label class="block text-sm font-semibold text-fg mb-2">Deadline</label>
                    <input type="date" name="deadline" id="editDeadline" required class="w-full px-4 py-2.5 bg-inputBg border border-border rounded-xl text-fg focus:border-accent transition-colors text-sm">
                </div>
            </div>
            
            <div class="grid grid-cols-3 gap-4">
                <div>
                    <label class="block text-sm font-semibold text-fg mb-2">Status</label>
                    <select name="status" id="editStatus" required class="w-full px-4 py-2.5 bg-inputBg border border-border rounded-xl text-fg appearance-none cursor-pointer focus:border-accent transition-colors text-sm">
                        <option value="Todo">Todo</option>
                        <option value="On Progress">On Progress</option>
                        <option value="Done">Done</option>
                    </select>
                </div>
                <div>
                    <label class="block text-sm font-semibold text-fg mb-2">Ganti Foto</label>
                    <input type="file" id="editFotoInput" accept="image/*" class="w-full text-[11px] text-fg file:mr-2 file:py-1.5 file:px-3 file:rounded file:border-0 file:font-semibold file:bg-accentLight file:text-accent cursor-pointer">
                    <input type="hidden" name="foto" id="editFotoBase64">
                </div>
                <div>
                    <label class="block text-sm font-semibold text-fg mb-2">Lampiran Link</label>
                    <input type="url" name="link" id="editLink" class="w-full px-4 py-2 bg-inputBg border border-border rounded-xl text-fg focus:border-accent transition-colors text-sm" placeholder="https://...">
                </div>
            </div>
            
            <div>
                <label class="block text-sm font-semibold text-fg mb-2 mt-4">Assign Student Staff</label>
                <div class="flex flex-wrap gap-3 max-h-36 overflow-y-auto p-3 bg-inputBg border border-border rounded-xl hide-scrollbar" id="editAssigneesContainer">
                    <% if (karyawanList && karyawanList.length > 0) { %>
                        <% karyawanList.forEach(k => { %>
                            <label class="cursor-pointer relative group flex items-center justify-center">
                                <input type="checkbox" name="assignees" value="<%= k.id %>" class="hidden avatar-cb edit-assignee-cb">
                                <div class="w-10 h-10 rounded-full bg-accentLight text-accent flex items-center justify-center text-sm font-bold border-2 border-transparent transition-all shadow-sm" title="<%= k.nama %>">
                                    <%= k.nama.split(/\s+/).slice(0,2).map(n=>n[0]).join('').toUpperCase() %>
                                </div>
                                <div class="absolute bottom-full mb-2 hidden group-hover:block whitespace-nowrap bg-gray-800 text-white text-xs px-2 py-1 rounded shadow-lg z-10"><%= k.nama %></div>
                            </label>
                        <% }) %>
                    <% } %>
                </div>
            </div>
            
            <div class="mt-6 pt-4 border-t border-border flex justify-end gap-3">
                <button type="button" onclick="closeEditModal()" class="px-5 py-2.5 bg-inputBg text-muted font-semibold rounded-xl hover:bg-border transition-colors text-sm">Batal</button>
                <button type="submit" class="px-5 py-2.5 bg-accent text-white font-medium rounded-xl hover:bg-accentHover transition-colors text-sm">Simpan Perubahan</button>
