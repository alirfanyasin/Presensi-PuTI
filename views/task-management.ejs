<!-- Scripts for SPA behavior -->
<script>
    let allTasks = <%- JSON.stringify(tasks || []) %>;
    
    // Determine active workspace from localStorage or fallback to first workspace
    const validWorkspaces = <%- JSON.stringify((workspaces || []).map(w => w.nama)) %>;
    let currentWorkspace = localStorage.getItem('activeWorkspace');
    if (!currentWorkspace || !validWorkspaces.includes(currentWorkspace)) {
        currentWorkspace = validWorkspaces.length > 0 ? validWorkspaces[0] : 'General';
    }

    let currentSearch = '';
    let currentView = localStorage.getItem('activeView') || 'kanban';
    let currentPage = 1;
    let itemsPerPage = 10;
    let sortableInstances = [];
    
    // Image Compression Helper (Canvas)
    function compressImage(file, callback) {
        const reader = new FileReader();
        reader.onload = function(e) {
            const img = new Image();
            img.onload = function() {
                const canvas = document.createElement('canvas');
                let width = img.width;
                let height = img.height;
                const maxDim = 800; // max width/height

                if (width > height) {
                    if (width > maxDim) {
                        height *= maxDim / width;
                        width = maxDim;
                    }
                } else {
                    if (height > maxDim) {
                        width *= maxDim / height;
                        height = maxDim;
                    }
                }
                canvas.width = width;
                canvas.height = height;
                const ctx = canvas.getContext('2d');
                ctx.drawImage(img, 0, 0, width, height);
                const dataUrl = canvas.toDataURL('image/jpeg', 0.6); // 60% quality jpeg
                callback(dataUrl);
            };
            img.src = e.target.result;
        };
        reader.readAsDataURL(file);
    }

    // File Upload Handlers
    document.getElementById('addFotoInput').addEventListener('change', function(e) {
        const file = e.target.files[0];
        if(file) compressImage(file, data => { document.getElementById('addFotoBase64').value = data; });
    });

    document.getElementById('editFotoInput').addEventListener('change', function(e) {
        const file = e.target.files[0];
        if(file) compressImage(file, data => { document.getElementById('editFotoBase64').value = data; });
    });
    
    let audioContext;
    function playVoiceAnnouncement(text) {
        return new Promise(async (resolve) => {
            try {
                if (!audioContext) audioContext = new (window.AudioContext || window.webkitAudioContext)();
                if (audioContext.state === 'suspended') await audioContext.resume();
                const utterance = new SpeechSynthesisUtterance(text);
                utterance.lang = 'id-ID';
                utterance.rate = 1.0;
                utterance.pitch = 1.0;
                utterance.onend = resolve;
                utterance.onerror = resolve;
                window.speechSynthesis.speak(utterance);
                
                // Fallback timeout in case onend doesn't fire
                setTimeout(resolve, 8000); 
            } catch (e) { 
                console.error("Audio error:", e); 
                resolve();
            }
        });
    }

    function getInitials(name) {
        if (!name) return "";
        const parts = name.trim().split(/\s+/);
        if (parts.length >= 2) return (parts[0].charAt(0) + parts[1].charAt(0)).toUpperCase();
        return parts[0].substring(0, 2).toUpperCase();
    }

    function getPriorityHtml(priority) {
        const map = {
            'Low': 'bg-gray-100 text-gray-700',
            'Medium': 'bg-blue-100 text-blue-700',
            'High': 'bg-orange-100 text-orange-700',
            'Critical': 'bg-red-100 text-red-700'
        };
        const c = map[priority] || map['Low'];
        return `<span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider ${c}">${priority || 'Low'}</span>`;
    }

    document.addEventListener('DOMContentLoaded', () => {
        setWorkspace(currentWorkspace); // triggers renderDashboard
        setViewMode(currentView);
        setupSSE();
    });

    function getFilteredTasks() {
        return allTasks.filter(t => {
            const matchWs = (t.workspace || 'General') === currentWorkspace;
            const matchSearch = currentSearch === '' || 
                                t.task.toLowerCase().includes(currentSearch.toLowerCase()) || 
                                (t.code || '').toLowerCase().includes(currentSearch.toLowerCase()) ||
                                (t.requester || '').toLowerCase().includes(currentSearch.toLowerCase());
            return matchWs && matchSearch;
        });
    }

    function renderDashboard() {
        const filtered = getFilteredTasks();
        const todo = filtered.filter(t => t.status === 'Todo').length;
        const prog = filtered.filter(t => t.status === 'On Progress').length;
        const done = filtered.filter(t => t.status === 'Done').length;
        const total = filtered.length;
        const rate = total > 0 ? Math.round((done / total) * 100) : 0;

        document.getElementById('metricTotal').textContent = total;
        document.getElementById('metricTodo').textContent = todo;
        document.getElementById('metricProgress').textContent = prog;
        document.getElementById('metricDone').textContent = done;
        document.getElementById('metricDoneRate').textContent = rate + '%';
        document.getElementById('metricDoneBar').style.width = rate + '%';

        if (currentView === 'kanban') {
            document.getElementById('viewKanban').classList.remove('hidden');
            document.getElementById('viewList').classList.add('hidden');
            renderKanban(filtered);
        } else {
            document.getElementById('viewKanban').classList.add('hidden');
            document.getElementById('viewList').classList.remove('hidden');
            renderList(filtered);
        }
        
        // Update Add Form Workspace Default
        document.getElementById('addWorkspaceSelect').value = currentWorkspace;
    }

    function renderKanban(tasks) {
        const cols = {
            'Todo': document.getElementById('colTodo'),
            'On Progress': document.getElementById('colProgress'),
            'Done': document.getElementById('colDone')
        };
        cols['Todo'].innerHTML = '';
        cols['On Progress'].innerHTML = '';
        cols['Done'].innerHTML = '';
        
        // Sort by order_index
        tasks.sort((a, b) => (a.order_index || 0) - (b.order_index || 0));

        let cTodo=0, cProg=0, cDone=0;
        tasks.forEach(t => {
            const card = document.createElement('div');
            card.className = 'task-card bg-card border border-border rounded-xl p-4 shadow-sm relative group';
            card.dataset.id = t.id;
            card.dataset.status = t.status;
            
            let assigneesHtml = '<span class="text-xs text-muted">Belum di-assign</span>';
            if (t.assignees) {
                const names = t.assignees.split(', ');
                assigneesHtml = `<div class="flex -space-x-2">` + 
                    names.map(n => `<div class="w-6 h-6 rounded-full bg-accentLight border-2 border-card flex items-center justify-center text-[8px] font-bold text-accent shadow-sm" title="${n}">${getInitials(n)}</div>`).join('') + 
                `</div>`;
            }

            card.innerHTML = `
                <div class="flex justify-between items-start mb-2">
                    <div class="flex gap-2 items-center">
                        <span class="text-[10px] font-mono font-bold text-accent bg-accent/10 px-1.5 py-0.5 rounded">${t.code || '-'}</span>
                        ${getPriorityHtml(t.priority)}
                    </div>
                    <div class="flex gap-1 opacity-0 group-hover:opacity-100 transition-opacity">
                        <button onclick='openEditModalObj(${JSON.stringify(t).replace(/'/g, "&#39;")})' class="text-muted hover:text-accent p-1 bg-inputBg rounded"><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg></button>
                        <button onclick='openDetailModalObj(${JSON.stringify(t).replace(/'/g, "&#39;")})' class="text-muted hover:text-accent p-1 bg-inputBg rounded"><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg></button>
                    </div>
                </div>
                <h4 class="font-semibold text-sm text-fg mb-3">${t.task}</h4>
                <div class="flex justify-between items-end mt-auto pt-2 border-t border-border/50">
                    <div class="flex flex-col gap-1">
                        <span class="text-[10px] text-muted flex items-center gap-1 font-medium"><svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg> ${t.deadline}</span>
                    </div>
                    ${assigneesHtml}
                </div>
            `;

            if(t.status === 'Todo') { cols['Todo'].appendChild(card); cTodo++; }
            else if(t.status === 'On Progress') { cols['On Progress'].appendChild(card); cProg++; }
            else if(t.status === 'Done') { cols['Done'].appendChild(card); cDone++; }
        });
        
        document.getElementById('countTodo').textContent = cTodo;
        document.getElementById('countProgress').textContent = cProg;
        document.getElementById('countDone').textContent = cDone;
        
        setupSortableJS();
    }
    
    function setupSortableJS() {
        // Destroy existing instances
        sortableInstances.forEach(inst => inst.destroy());
        sortableInstances = [];

        const columns = document.querySelectorAll('.kanban-col [id^="col"]');
        columns.forEach(colInner => {
            const colOuter = colInner.closest('.kanban-col');
            const inst = new Sortable(colInner, {
                group: 'shared-kanban',
                animation: 150,
                ghostClass: 'sortable-ghost',
                dragClass: 'task-card--dragging',
                onEnd: function (evt) {
                    const itemEl = evt.item;
                    const newStatus = evt.to.closest('.kanban-col').dataset.status;
                    const id = itemEl.dataset.id;

                    // Optimistic local update of status
                    const taskIndex = allTasks.findIndex(t => t.id == id);
                    if (taskIndex > -1) {
                        allTasks[taskIndex].status = newStatus;
                    }

                    // Gather new order for the destination column
                    const updates = [];
                    Array.from(evt.to.children).forEach((child, index) => {
                        if (child.dataset.id) {
                            updates.push({ id: parseInt(child.dataset.id), status: newStatus, order_index: index });
                            const tIdx = allTasks.findIndex(t => t.id == child.dataset.id);
                            if (tIdx > -1) allTasks[tIdx].order_index = index;
                        }
                    });

                    // Gather new order for the source column if moved across columns
                    if (evt.from !== evt.to) {
                        const fromStatus = evt.from.closest('.kanban-col').dataset.status;
                        Array.from(evt.from.children).forEach((child, index) => {
                            if (child.dataset.id) {
                                updates.push({ id: parseInt(child.dataset.id), status: fromStatus, order_index: index });
                                const tIdx = allTasks.findIndex(t => t.id == child.dataset.id);
                                if (tIdx > -1) allTasks[tIdx].order_index = index;
                            }
                        });
                    }

                    // Only update metrics counts — do NOT call renderKanban/renderDashboard
                    // because that would re-build the DOM and fight with SortableJS
                    updateKanbanMetrics();

                    // Persist to server
                    fetch('/task-management/update-order', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ updates })
                    }).catch(err => console.error('Error updating order:', err));
                }
            });
            sortableInstances.push(inst);
        });
    }

    function updateKanbanMetrics() {
        // Re-count from live DOM (not allTasks) to avoid off-by-one after drag
        const cTodo = document.getElementById('colTodo').children.length;
        const cProg = document.getElementById('colProgress').children.length;
        const cDone = document.getElementById('colDone').children.length;
        const total = cTodo + cProg + cDone;
        const rate = total > 0 ? Math.round((cDone / total) * 100) : 0;

        document.getElementById('countTodo').textContent = cTodo;
        document.getElementById('countProgress').textContent = cProg;
        document.getElementById('countDone').textContent = cDone;
        document.getElementById('metricTotal').textContent = total;
        document.getElementById('metricTodo').textContent = cTodo;
        document.getElementById('metricProgress').textContent = cProg;
        document.getElementById('metricDone').textContent = cDone;
        document.getElementById('metricDoneRate').textContent = rate + '%';
        document.getElementById('metricDoneBar').style.width = rate + '%';
    }

    function renderList(tasks) {
        const tbody = document.getElementById('listTableBody');
        tbody.innerHTML = '';
        
        // Sort lists by Status -> Priority -> Deadline DESC
        const statusWeight = { 'Todo': 1, 'On Progress': 2, 'Done': 3 };
        const priorityWeight = { 'Critical': 1, 'High': 2, 'Medium': 3, 'Low': 4 };
        
        tasks.sort((a, b) => {
            // 1. Status (Todo -> On Progress -> Done)
            const sA = statusWeight[a.status] || 99;
            const sB = statusWeight[b.status] || 99;
            if (sA !== sB) return sA - sB;

            // 2. Prioritas (Critical -> High -> Medium -> Low)
            const pA = priorityWeight[a.priority] || 99;
            const pB = priorityWeight[b.priority] || 99;
            if (pA !== pB) return pA - pB;

            // 3. Deadline DESC (Terbaru ke Terlama)
            const dA = new Date(a.deadline).getTime() || 0;
            const dB = new Date(b.deadline).getTime() || 0;
            if (dA !== dB) return dB - dA;

            return 0;
        });

        const total = tasks.length;
        const totalPages = Math.ceil(total / itemsPerPage);
        if (currentPage > totalPages && totalPages > 0) currentPage = totalPages;
        
        const start = (currentPage - 1) * itemsPerPage;
        const end = Math.min(start + itemsPerPage, total);
        
        document.getElementById('pageStart').textContent = total === 0 ? 0 : start + 1;
        document.getElementById('pageEnd').textContent = end;
        document.getElementById('totalCount').textContent = total;
        
        const pageTasks = tasks.slice(start, end);
        if (pageTasks.length === 0) {
            tbody.innerHTML = `<tr><td colspan="7" class="py-8 text-center text-sm text-muted">Tidak ada tiket ditemukan.</td></tr>`;
        } else {
            pageTasks.forEach(t => {
                let assigneesHtml = '<span class="text-xs text-muted">Belum di-assign</span>';
                if (t.assignees) {
                    const names = t.assignees.split(', ');
                    assigneesHtml = `<div class="flex -space-x-2">` + 
                        names.map(n => `<div class="w-8 h-8 rounded-full bg-accentLight border-2 border-card flex items-center justify-center text-[10px] font-bold text-accent shadow-sm" title="${n}">${getInitials(n)}</div>`).join('') + 
                    `</div>`;
                }
                let statusBadge = '';
                if(t.status === 'Todo') statusBadge = '<span class="px-2 py-1 rounded bg-amber-100 text-amber-800 text-xs font-bold">Todo</span>';
                if(t.status === 'On Progress') statusBadge = '<span class="px-2 py-1 rounded bg-blue-100 text-blue-800 text-xs font-bold">Progress</span>';
                if(t.status === 'Done') statusBadge = '<span class="px-2 py-1 rounded bg-green-100 text-green-800 text-xs font-bold">Done</span>';

                const tData = JSON.stringify(t).replace(/'/g, "&#39;");
                const tr = document.createElement('tr');
                tr.className = 'hover:bg-inputBg/50 transition-colors cursor-pointer select-none';
                tr.title = 'Klik untuk detail · Klik kanan untuk aksi';
                tr.innerHTML = `
                    <td class="px-6 py-4">
                        <div class="flex flex-col gap-1">
                            <span class="font-mono text-xs font-bold text-accent">${t.code || '-'}</span>
                            <span class="text-sm font-semibold text-fg line-clamp-1 max-w-[200px]" title="${t.task}">${t.task}</span>
                        </div>
                    </td>
                    <td class="px-6 py-4 text-sm text-muted">${t.workspace || 'General'}</td>
                    <td class="px-6 py-4 text-sm text-fg">${t.requester || '-'}</td>
                    <td class="px-6 py-4 text-sm text-fg">${t.deadline}</td>
                    <td class="px-6 py-4">${getPriorityHtml(t.priority)}</td>
                    <td class="px-6 py-4">${statusBadge}</td>
                    <td class="px-6 py-4">${assigneesHtml}</td>
                `;
                // Left click → detail modal
                tr.addEventListener('click', () => openDetailModalObj(t));
                // Right click → context menu
                tr.addEventListener('contextmenu', (e) => {
                    e.preventDefault();
                    showContextMenu(e.clientX, e.clientY, t);
                });
                tbody.appendChild(tr);
            });
        }
        
        const pgControls = document.getElementById('paginationControls');
        pgControls.innerHTML = '';
        if(totalPages > 1) {
            if(currentPage > 1) {
                pgControls.innerHTML += `<button onclick="setPage(${currentPage-1})" class="px-3 py-1 bg-inputBg border border-border rounded text-sm hover:bg-border transition-colors">Prev</button>`;
            }
            if(currentPage < totalPages) {
                pgControls.innerHTML += `<button onclick="setPage(${currentPage+1})" class="px-3 py-1 bg-inputBg border border-border rounded text-sm hover:bg-border transition-colors">Next</button>`;
            }
        }
    }

    function setWorkspace(ws) {
        currentWorkspace = ws;
        localStorage.setItem('activeWorkspace', ws);
        document.querySelectorAll('.workspace-tab').forEach(btn => {
            btn.classList.toggle('active', btn.dataset.ws === ws);
        });
        currentPage = 1;
        renderDashboard();
    }
    
    function setViewMode(mode) {
        currentView = mode;
        localStorage.setItem('activeView', mode);
        document.getElementById('btnViewKanban').classList.toggle('active', mode === 'kanban');
        document.getElementById('btnViewList').classList.toggle('active', mode === 'list');
        renderDashboard();
    }

    function applyFilters() {
        currentSearch = document.getElementById('searchInput').value;
        currentPage = 1;
        renderDashboard();
    }

    function setPage(p) {
        currentPage = p;
        renderDashboard();
    }

    function setupSSE() {
        if (!window.EventSource) return;
        const evtSource = new EventSource('/api/events');
        evtSource.onmessage = function(event) {
            try {
                const data = JSON.parse(event.data);
                if (data.type === 'task') {
                    if (data.action === 'status-updated') {
                        const idx = allTasks.findIndex(t => t.id == data.taskId);
                        if (idx > -1) {
                            allTasks[idx].status = data.status;
                            renderDashboard();
                            if (data.status === 'On Progress' && data.assignees) {
                                playVoiceAnnouncement(`Tiket dengan kode ${data.code} sedang dikerjakan oleh ${data.assignees}`);
                            } else if (data.status === 'Done') {
                                playVoiceAnnouncement(`Tiket dengan kode ${data.code} telah selesai dikerjakan`);
                            }
                        }
                    } else if (data.action === 'add' || data.action === 'added' || data.action === 'edited') {
                        let textToPlay = null;
                        if (data.task && data.task.assignees) {
                            if (data.action === 'add' || data.action === 'added') {
                                textToPlay = `Tugas baru untuk ${data.task.assignees} dengan kode ${data.task.code || '-'}`;
                            } else if (data.action === 'edited' && data.assigneesChanged) {
                                textToPlay = `Tugas dengan kode ${data.task.code || '-'} diperbarui penugasannya ke ${data.task.assignees}`;
                            }
                        }
                        
                        if (textToPlay) {
                            playVoiceAnnouncement(textToPlay).then(() => {
                                window.location.reload(); 
                            });
                        } else {
                            window.location.reload(); 
                        }
                    } else if (data.action === 'delete') {
                        allTasks = allTasks.filter(t => t.id != data.taskId);
                        renderDashboard();
                    }
                }
            } catch (e) {
                console.error("SSE parse error", e);
            }
        };
    }

