</div>

<script>
    // Safe modal openers using encoded attributes
    function openDetail(btn) {
        const data = JSON.parse(decodeURIComponent(btn.getAttribute('data-task')));
        openDetailModal(data);
    }

    function openEdit(btn) {
        const data = JSON.parse(decodeURIComponent(btn.getAttribute('data-task')));
        openEditModal(data);
    }

    function openDelete(btn) {
        const data = JSON.parse(decodeURIComponent(btn.getAttribute('data-task')));
        openDeleteModal(data);
    }

    // Helper function for initials
    function getInitials(name) {
        if (!name) return "";
        const parts = name.trim().split(/\s+/);
        if (parts.length >= 2) {
            return (parts[0].charAt(0) + parts[1].charAt(0)).toUpperCase();
        }
        return parts[0].substring(0, 2).toUpperCase();
    }

    // Detail Modal
    const detailModal = document.getElementById('detailModal');
    const detailModalContent = document.getElementById('detailModalContent');
    function openDetailModal(data) {
        document.getElementById('detailTaskCode').textContent = data.code || '-';
        document.getElementById('detailTaskDescription').textContent = data.task;
        document.getElementById('detailStartDate').textContent = data.tanggal;
        document.getElementById('detailDeadline').textContent = data.deadline;
        
        const statusContainer = document.getElementById('detailStatusBadge');
        statusContainer.innerHTML = '';
        if (data.status === 'Todo') {
            statusContainer.innerHTML = `<span class="inline-flex items-center px-3 py-1.5 rounded-full text-xs font-bold bg-amber-100 text-amber-800">Todo</span>`;
        } else if (data.status === 'On Progress') {
            statusContainer.innerHTML = `<span class="inline-flex items-center px-3 py-1.5 rounded-full text-xs font-bold bg-blue-100 text-blue-800">On Progress</span>`;
        } else if (data.status === 'Done') {
            statusContainer.innerHTML = `<span class="inline-flex items-center px-3 py-1.5 rounded-full text-xs font-bold bg-green-100 text-green-800">Done</span>`;
        }

        const assigneeContainer = document.getElementById('detailAssigneeList');
        assigneeContainer.innerHTML = '';
        if (data.assignees) {
            const names = data.assignees.split(', ');
            names.forEach(name => {
                const initials = getInitials(name);
                const item = document.createElement('div');
                item.className = 'flex items-center gap-3 p-1.5 hover:bg-card/40 rounded-xl transition-colors';
                item.innerHTML = `
                    <div class="w-8 h-8 rounded-full bg-accentLight flex items-center justify-center text-[10px] font-bold text-accent flex-shrink-0">
                        ${initials}
                    </div>
                    <span class="text-sm font-semibold text-fg truncate">${name}</span>
                `;
                assigneeContainer.appendChild(item);
            });
        } else {
            assigneeContainer.innerHTML = `<p class="text-xs text-muted py-2 text-center">Belum di-assign</p>`;
        }

        const attachmentSection = document.getElementById('detailAttachmentSection');
        const imagePreview = document.getElementById('detailImagePreview');
        const imageWrapper = document.getElementById('detailImageWrapper');
        if (data.foto) {
            attachmentSection.classList.remove('hidden');
            imagePreview.src = data.foto;
            imageWrapper.onclick = function() {
                showTaskPhoto(data.foto, data.task);
            };
        } else {
            attachmentSection.classList.add('hidden');
            imagePreview.src = '';
            imageWrapper.onclick = null;
        }

        detailModal.classList.remove('hidden');
        setTimeout(() => {
            detailModal.classList.remove('opacity-0');
            detailModalContent.classList.remove('scale-95');
        }, 10);
    }

    function closeDetailModal() {
        detailModal.classList.add('opacity-0');
        detailModalContent.classList.add('scale-95');
        setTimeout(() => detailModal.classList.add('hidden'), 300);
    }
    // Add Modal
    const addModal = document.getElementById('addModal');
    const addModalContent = document.getElementById('addModalContent');
    function openAddModal() {
        addModal.classList.remove('hidden');
        setTimeout(() => {
            addModal.classList.remove('opacity-0');
            addModalContent.classList.remove('scale-95');
        }, 10);
    }
    function closeAddModal() {
        addModal.classList.add('opacity-0');
        addModalContent.classList.add('scale-95');
        setTimeout(() => addModal.classList.add('hidden'), 300);
    }

    // Edit Modal
    const editModal = document.getElementById('editModal');
    const editModalContent = document.getElementById('editModalContent');
    function openEditModal(data) {
        document.getElementById('editId').value = data.id;
        document.getElementById('editTask').value = data.task;
        document.getElementById('editTanggal').value = data.tanggal;
        document.getElementById('editDeadline').value = data.deadline;
        document.getElementById('editStatus').value = data.status;
        
        // Clear checkboxes
        const checkboxes = document.querySelectorAll('.edit-assignee-checkbox');
        checkboxes.forEach(cb => cb.checked = false);

        // Check assigned staff
        if (data.assigneeIds && Array.isArray(data.assigneeIds)) {
            data.assigneeIds.forEach(id => {
                const cb = document.querySelector(`.edit-assignee-checkbox[value="${id}"]`);
                if (cb) cb.checked = true;
            });
        }

        // Image preview edit modal
        const preview = document.getElementById('editTaskImagePreview');
        const fotoInput = document.getElementById('editTaskFotoInput');
        const fileInput = document.getElementById('editTaskImageInput');
        fileInput.value = '';
        if (data.foto) {
            preview.src = data.foto;
            preview.classList.remove('hidden');
            fotoInput.value = data.foto;
        } else {
            preview.src = '';
            preview.classList.add('hidden');
            fotoInput.value = '';
        }

        editModal.classList.remove('hidden');
        setTimeout(() => {
            editModal.classList.remove('opacity-0');
            editModalContent.classList.remove('scale-95');
        }, 10);
    }
    function closeEditModal() {
        editModal.classList.add('opacity-0');
        editModalContent.classList.add('scale-95');
        setTimeout(() => editModal.classList.add('hidden'), 300);
    }

    // Delete Modal
    const deleteModal = document.getElementById('deleteModal');
    const deleteModalContent = document.getElementById('deleteModalContent');
    function openDeleteModal(data) {
        document.getElementById('deleteId').value = data.id;
        document.getElementById('deleteTaskName').textContent = data.task;
        
        deleteModal.classList.remove('hidden');
        setTimeout(() => {
            deleteModal.classList.remove('opacity-0');
            deleteModalContent.classList.remove('scale-95');
        }, 10);
    }
    function closeDeleteModal() {
        deleteModal.classList.add('opacity-0');
        deleteModalContent.classList.add('scale-95');
        setTimeout(() => deleteModal.classList.add('hidden'), 300);
    }

    // FileReader and Compression handlers
    function compressImage(file, callback) {
        const reader = new FileReader();
        reader.onload = function(e) {
            const img = new Image();
            img.onload = function() {
                const canvas = document.createElement('canvas');
                const MAX_WIDTH = 1200;
                const MAX_HEIGHT = 1200;
                let width = img.width;
                let height = img.height;

                if (width > height) {
                    if (width > MAX_WIDTH) {
                        height *= MAX_WIDTH / width;
                        width = MAX_WIDTH;
                    }
                } else {
                    if (height > MAX_HEIGHT) {
                        width *= MAX_HEIGHT / height;
                        height = MAX_HEIGHT;
                    }
                }

                canvas.width = width;
                canvas.height = height;
                const ctx = canvas.getContext('2d');
                ctx.drawImage(img, 0, 0, width, height);

                // Compress as JPEG with 0.7 quality
                const compressedBase64 = canvas.toDataURL('image/jpeg', 0.7);
                callback(compressedBase64);
            };
            img.src = e.target.result;
        };
        reader.readAsDataURL(file);
    }

    function setupImageUpload(inputEl, hiddenInputEl, previewEl) {
        inputEl.addEventListener('change', function(e) {
            const file = e.target.files[0];
            if (file) {
                compressImage(file, function(compressedBase64) {
                    hiddenInputEl.value = compressedBase64;
                    previewEl.src = compressedBase64;
                    previewEl.classList.remove('hidden');
                });
            }
        });
    }

    setupImageUpload(
        document.getElementById('taskImageInput'),
        document.getElementById('taskFotoInput'),
        document.getElementById('taskImagePreview')
    );

    setupImageUpload(
        document.getElementById('editTaskImageInput'),
        document.getElementById('editTaskFotoInput'),
        document.getElementById('editTaskImagePreview')
    );

    // Fullscreen photo modal
    function showTaskPhoto(fotoUrl) {
        if (!fotoUrl) return;
        const photoModal = document.getElementById('photoModal');
        const modalPhotoImg = document.getElementById('modalPhotoImg');
        
        modalPhotoImg.src = fotoUrl;

        photoModal.classList.remove('hidden');
        setTimeout(() => {
            photoModal.classList.remove('opacity-0');
        }, 10);
    }

    function closePhotoModal() {
        const photoModal = document.getElementById('photoModal');
        const modalPhotoImg = document.getElementById('modalPhotoImg');
        
        photoModal.classList.add('opacity-0');
        setTimeout(() => {
            photoModal.classList.add('hidden');
            modalPhotoImg.src = '';
        }, 300);
    }

    // Client-side Pagination and Filtering Logic
    let currentPage = 1;
    const itemsPerPage = 10;
    let filteredRows = [];
    let filteredCards = [];

    function applyFilters() {
        const searchValue = document.getElementById('searchFilter').value.toLowerCase().trim();
        const statusValue = document.getElementById('statusFilter').value;
        const dateValue = document.getElementById('dateFilter').value;

        // Handle date clear button visibility
        const clearBtn = document.getElementById('clearDateBtn');
        if (dateValue) {
            clearBtn.classList.remove('hidden');
        } else {
            clearBtn.classList.add('hidden');
        }

        const rows = Array.from(document.querySelectorAll('.task-row'));
        const cards = Array.from(document.querySelectorAll('.task-card'));

        // Filter rows
        filteredRows = rows.filter(row => {
            const task = row.getAttribute('data-task').toLowerCase();
            const code = (row.getAttribute('data-code') || '').toLowerCase();
            const assignees = row.getAttribute('data-assignees').toLowerCase();
            const status = row.getAttribute('data-status');
            const date = row.getAttribute('data-date'); // YYYY-MM-DD

            const matchesSearch = !searchValue || task.includes(searchValue) || code.includes(searchValue) || assignees.includes(searchValue);
            const matchesStatus = !statusValue || status === statusValue;
            const matchesDate = !dateValue || date === dateValue;

            return matchesSearch && matchesStatus && matchesDate;
        });

        // Filter cards
        filteredCards = cards.filter(card => {
            const task = card.getAttribute('data-task').toLowerCase();
            const code = (card.getAttribute('data-code') || '').toLowerCase();
            const assignees = card.getAttribute('data-assignees').toLowerCase();
            const status = card.getAttribute('data-status');
            const date = card.getAttribute('data-date');

            const matchesSearch = !searchValue || task.includes(searchValue) || code.includes(searchValue) || assignees.includes(searchValue);
            const matchesStatus = !statusValue || status === statusValue;
            const matchesDate = !dateValue || date === dateValue;

            return matchesSearch && matchesStatus && matchesDate;
        });

        // Reset page
        currentPage = 1;
        showPage();
    }

    function showPage() {
        const totalItems = filteredRows.length;
        const totalPages = Math.ceil(totalItems / itemsPerPage) || 1;

        // Ensure currentPage is within range
        if (currentPage < 1) currentPage = 1;
        if (currentPage > totalPages) currentPage = totalPages;

        const startIndex = (currentPage - 1) * itemsPerPage;
        const endIndex = Math.min(startIndex + itemsPerPage, totalItems);

        // Hide all rows/cards first
        document.querySelectorAll('.task-row').forEach(row => row.classList.add('hidden'));
        document.querySelectorAll('.task-card').forEach(card => card.classList.add('hidden'));

        // Show paginated rows/cards and dynamic numbering
        let count = startIndex + 1;
        for (let i = startIndex; i < endIndex; i++) {
            if (filteredRows[i]) {
                filteredRows[i].classList.remove('hidden');
                const indexCell = filteredRows[i].querySelector('.task-index');
                if (indexCell) indexCell.textContent = count++;
            }
            if (filteredCards[i]) {
                filteredCards[i].classList.remove('hidden');
            }
        }

        // Update total info text
        document.getElementById('pageStart').textContent = totalItems === 0 ? 0 : startIndex + 1;
        document.getElementById('pageEnd').textContent = endIndex;
        document.getElementById('totalCount').textContent = totalItems;

        // Handle empty state
        const desktopEmpty = document.getElementById('desktopEmptyState');
        const mobileEmpty = document.getElementById('mobileEmptyState');
        const paginationContainer = document.getElementById('paginationContainer');
        
        if (totalItems === 0) {
            if (desktopEmpty) desktopEmpty.classList.remove('hidden');
            if (mobileEmpty) mobileEmpty.classList.remove('hidden');
            if (paginationContainer) paginationContainer.classList.add('hidden');
        } else {
            if (desktopEmpty) desktopEmpty.classList.add('hidden');
            if (mobileEmpty) mobileEmpty.classList.add('hidden');
            if (paginationContainer) paginationContainer.classList.remove('hidden');
        }

        // Render page numbers
        renderPageNumbers(totalPages);
    }

    function renderPageNumbers(totalPages) {
        const container = document.getElementById('pageNumbersContainer');
        if (!container) return;
        container.innerHTML = '';

        // Prev Button
        const prevBtn = document.createElement('button');
        prevBtn.type = 'button';
        prevBtn.className = `relative inline-flex items-center rounded-lg px-2.5 py-1.5 text-sm font-medium transition-colors ${currentPage === 1 ? 'text-muted cursor-not-allowed' : 'text-fg hover:bg-border'}`;
        prevBtn.innerHTML = `<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>`;
        prevBtn.onclick = () => { if (currentPage > 1) { currentPage--; showPage(); } };
        container.appendChild(prevBtn);

        // Page numbers
        for (let i = 1; i <= totalPages; i++) {
            const pageBtn = document.createElement('button');
            pageBtn.type = 'button';
            pageBtn.className = `relative inline-flex items-center rounded-lg px-3.5 py-1.5 text-sm font-semibold transition-colors ${currentPage === i ? 'bg-accent text-white' : 'text-fg hover:bg-border'}`;
            pageBtn.textContent = i;
            pageBtn.onclick = () => { currentPage = i; showPage(); };
            container.appendChild(pageBtn);
        }

        // Next Button
        const nextBtn = document.createElement('button');
        nextBtn.type = 'button';
        nextBtn.className = `relative inline-flex items-center rounded-lg px-2.5 py-1.5 text-sm font-medium transition-colors ${currentPage === totalPages ? 'text-muted cursor-not-allowed' : 'text-fg hover:bg-border'}`;
        nextBtn.innerHTML = `<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>`;
        nextBtn.onclick = () => { if (currentPage < totalPages) { currentPage++; showPage(); } };
        container.appendChild(nextBtn);

        // Mobile Buttons
        const prevMobile = document.getElementById('prevMobileBtn');
        const nextMobile = document.getElementById('nextMobileBtn');
        if (prevMobile && nextMobile) {
            prevMobile.disabled = currentPage === 1;
            nextMobile.disabled = currentPage === totalPages;
            prevMobile.className = `relative inline-flex items-center rounded-xl border border-border bg-inputBg px-4 py-2 text-sm font-medium transition-colors ${currentPage === 1 ? 'text-muted cursor-not-allowed' : 'text-fg hover:bg-border'}`;
            nextMobile.className = `relative ml-3 inline-flex items-center rounded-xl border border-border bg-inputBg px-4 py-2 text-sm font-medium transition-colors ${currentPage === totalPages ? 'text-muted cursor-not-allowed' : 'text-fg hover:bg-border'}`;
            prevMobile.onclick = () => { if (currentPage > 1) { currentPage--; showPage(); } };
            nextMobile.onclick = () => { if (currentPage < totalPages) { currentPage++; showPage(); } };
        }
    }

    function clearDateFilter() {
        document.getElementById('dateFilter').value = '';
        applyFilters();
    }

    // Initialize pagination and filtering on page load
    document.addEventListener('DOMContentLoaded', () => {
        applyFilters();
    });
</script>
