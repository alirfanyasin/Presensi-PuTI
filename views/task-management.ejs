<%- include('partials/header', { title: 'Task Management' }) %>
<%- include('partials/nav', { path: '/task-management' }) %>

<% 
  const getInitials = (name) => {
    if (!name) return "";
    const parts = name.trim().split(/\s+/);
    if (parts.length >= 2) {
      return (parts[0].charAt(0) + parts[1].charAt(0)).toUpperCase();
    }
    return parts[0].substring(0, 2).toUpperCase();
  };
%>

<main class="flex-grow w-full max-w-[1440px] mx-auto px-4 sm:px-6 lg:px-8 py-6 sm:py-12">
    <!-- Page Header -->
    <div class="mb-6 sm:mb-8 animate-fadeInUp flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
            <h2 class="font-display text-2xl sm:text-4xl font-bold text-fg mb-1">Task Management</h2>
            <p class="text-xs sm:text-sm text-muted">Kelola dan delegasikan tugas Student Staff secara terorganisir</p>
        </div>
        <button onclick="openAddModal()" class="px-5 py-2.5 bg-accent text-white font-medium rounded-xl hover:bg-accentHover transition-colors btn-press text-sm inline-flex items-center gap-2">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"/></svg>
            Tambah Task
        </button>
    </div>

    <% if (typeof success_msg !== 'undefined' && success_msg) { %>
        <div class="mb-6 bg-success/20 text-success border border-success/30 px-4 py-3 rounded-xl animate-fadeInUp font-semibold text-sm">
            <%= success_msg %>
        </div>
    <% } %>
    <% if (typeof error_msg !== 'undefined' && error_msg) { %>
        <div class="mb-6 bg-red-500/20 text-red-500 border border-red-500/30 px-4 py-3 rounded-xl animate-fadeInUp font-semibold text-sm">
            <%= error_msg %>
        </div>
    <% } %>

    <!-- Filter & Search Bar -->
    <div class="bg-card rounded-2xl border border-border p-4 sm:p-5 mb-6 animate-fadeInUp stagger-1 flex flex-col md:flex-row items-stretch md:items-center justify-between gap-4 shadow-sm">
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 flex-grow">
            <!-- Search by Name/Task -->
            <div class="relative">
                <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-muted">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
                </span>
                <input type="text" id="searchFilter" oninput="applyFilters()" class="w-full pl-10 pr-4 py-2 bg-inputBg border border-border rounded-xl text-fg focus:border-accent transition-colors text-sm" placeholder="Cari tugas atau staff...">
            </div>

            <!-- Filter by Status -->
            <div class="relative">
                <select id="statusFilter" onchange="applyFilters()" class="w-full px-4 py-2 bg-inputBg border border-border rounded-xl text-fg appearance-none cursor-pointer focus:border-accent transition-colors text-sm">
                    <option value="">Semua Status</option>
                    <option value="Todo">Todo</option>
                    <option value="On Progress">On Progress</option>
                    <option value="Done">Done</option>
                </select>
                <span class="absolute inset-y-0 right-0 pr-3 flex items-center pointer-events-none text-muted">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
                </span>
            </div>

            <!-- Filter by Start Date -->
            <div class="relative flex items-center">
                <input type="date" id="dateFilter" onchange="applyFilters()" class="w-full px-4 py-2 bg-inputBg border border-border rounded-xl text-fg focus:border-accent transition-colors text-sm">
                <!-- Clear date button -->
                <button onclick="clearDateFilter()" class="absolute right-3 text-muted hover:text-fg focus:outline-none hidden" id="clearDateBtn">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
                </button>
            </div>
        </div>
    </div>

    <!-- Desktop Table Section -->
    <div class="hidden md:block bg-card rounded-2xl border border-border overflow-hidden animate-fadeInUp stagger-1 shadow-sm mb-6">
        <div class="table-container overflow-x-auto">
            <table class="w-full min-w-[800px]">
                <thead class="bg-accentLighter border-b border-border">
                    <tr>
                        <th class="px-4 sm:px-6 py-4 text-left text-xs font-bold text-accent uppercase tracking-wider">No</th>
                        <th class="px-4 sm:px-6 py-4 text-left text-xs font-bold text-accent uppercase tracking-wider">Kode</th>
                        <th class="px-4 sm:px-6 py-4 text-left text-xs font-bold text-accent uppercase tracking-wider">Tugas</th>
                        <th class="px-4 sm:px-6 py-4 text-left text-xs font-bold text-accent uppercase tracking-wider">Tanggal Mulai</th>
                        <th class="px-4 sm:px-6 py-4 text-left text-xs font-bold text-accent uppercase tracking-wider">Deadline</th>
                        <th class="px-4 sm:px-6 py-4 text-left text-xs font-bold text-accent uppercase tracking-wider">Status</th>
                        <th class="px-4 sm:px-6 py-4 text-left text-xs font-bold text-accent uppercase tracking-wider">Assignee</th>
                        <th class="px-4 sm:px-6 py-4 text-center text-xs font-bold text-accent uppercase tracking-wider">Aksi</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-border">
                    <% if (tasks && tasks.length === 0) { %>
                        <tr>
                            <td colspan="8" class="py-10 text-center">
                                <svg class="w-12 h-12 mx-auto text-border mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
                                </svg>
                                <p class="text-muted text-sm">Belum ada tugas terdaftar.</p>
                            </td>
                        </tr>
                    <% } else if (tasks) { %>
                        <% tasks.forEach((t, i) => { %>
                            <tr class="task-row hover:bg-accentLighter/30 transition-colors" data-id="<%= t.id %>" data-task="<%= t.task %>" data-code="<%= t.code || '' %>" data-status="<%= t.status %>" data-date="<%= t.tanggal %>" data-assignees="<%= t.assignees || '' %>">
                                <td class="px-4 sm:px-6 py-4 whitespace-nowrap text-sm text-muted font-medium task-index"><%= i + 1 %></td>
                                <td class="px-4 sm:px-6 py-4 whitespace-nowrap text-sm font-bold text-accent font-mono"><%= t.code || '-' %></td>
                                <td class="px-4 sm:px-6 py-4 text-sm text-fg font-semibold max-w-xs">
                                    <span style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; word-break: break-all;"><%= t.task %></span>
                                </td>
                                <td class="px-4 sm:px-6 py-4 whitespace-nowrap text-sm text-fg"><%= t.tanggal %></td>
                                <td class="px-4 sm:px-6 py-4 whitespace-nowrap text-sm text-fg font-medium text-accent"><%= t.deadline %></td>
                                <td class="px-4 sm:px-6 py-4 whitespace-nowrap text-sm">
                                    <% if (t.status === 'Todo') { %>
                                        <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-bold bg-amber-100 text-amber-800">
                                            Todo
                                        </span>
                                    <% } else if (t.status === 'On Progress') { %>
                                        <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-bold bg-blue-100 text-blue-800">
                                            On Progress
                                        </span>
                                    <% } else if (t.status === 'Done') { %>
                                        <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-bold bg-green-100 text-green-800">
                                            Done
                                        </span>
                                    <% } %>
                                </td>
                                <td class="px-4 sm:px-6 py-4 whitespace-nowrap">
                                    <div class="flex items-center -space-x-2">
                                        <% if (t.assignees) { %>
                                            <% t.assignees.split(', ').forEach(name => { %>
                                                <div class="w-8 h-8 rounded-full bg-accentLight border-2 border-card flex items-center justify-center text-[10px] font-bold text-accent cursor-pointer transition-transform hover:scale-110 hover:z-10" title="<%= name %>">
                                                    <%= getInitials(name) %>
                                                </div>
                                            <% }) %>
                                        <% } else { %>
                                            <span class="text-xs text-muted">Belum di-assign</span>
                                        <% } %>
                                    </div>
                                </td>
                                <td class="px-4 sm:px-6 py-4 whitespace-nowrap text-center">
                                    <div class="flex items-center justify-center gap-2">
                                        <button onclick="openDetail(this)" data-task="<%= encodeURIComponent(JSON.stringify(t)) %>" class="text-muted hover:text-accent transition-colors p-1.5 rounded hover:bg-accentLight/20" title="Detail">
                                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
                                        </button>
                                        <button onclick="openEdit(this)" data-task="<%= encodeURIComponent(JSON.stringify(t)) %>" class="text-muted hover:text-indigo-600 transition-colors p-1.5 rounded hover:bg-indigo-50" title="Edit">
                                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
                                        </button>
                                        <button onclick="openDelete(this)" data-task="<%= encodeURIComponent(JSON.stringify(t)) %>" class="text-muted hover:text-red-500 transition-colors p-1.5 rounded hover:bg-red-50" title="Hapus">
                                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        <% }) %>
                    <% } %>
                    <!-- Empty State for filtered desktop results -->
                    <tr id="desktopEmptyState" class="hidden">
                        <td colspan="8" class="py-10 text-center">
                            <svg class="w-12 h-12 mx-auto text-border mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
                            </svg>
                            <p class="text-muted text-sm">Tidak ada tugas yang sesuai dengan filter.</p>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

    <!-- Mobile Card Section -->
    <div class="md:hidden space-y-4 animate-fadeInUp stagger-1 mb-6">
        <% if (tasks && tasks.length === 0) { %>
            <div class="bg-card rounded-2xl border border-border p-8 text-center shadow-sm">
                <p class="text-muted text-sm">Belum ada tugas terdaftar.</p>
            </div>
        <% } else if (tasks) { %>
            <% tasks.forEach(t => { %>
                <div class="task-card bg-card rounded-2xl border border-border p-5 shadow-sm space-y-4" data-id="<%= t.id %>" data-task="<%= t.task %>" data-code="<%= t.code || '' %>" data-status="<%= t.status %>" data-date="<%= t.tanggal %>" data-assignees="<%= t.assignees || '' %>">
                    <div class="flex justify-between items-start">
                        <div class="space-y-1.5 pr-2">
                            <span class="inline-flex font-mono text-[10px] font-bold text-accent bg-accent/10 px-2 py-0.5 rounded-lg"><%= t.code || '-' %></span>
                            <h4 class="font-bold text-fg text-base" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; word-break: break-all;"><%= t.task %></h4>
                            <div class="flex flex-wrap gap-1.5 text-xs text-muted">
                                <span>Mulai: <strong class="text-fg"><%= t.tanggal %></strong></span>
                                <span>·</span>
                                <span>Deadline: <strong class="text-accent"><%= t.deadline %></strong></span>
                            </div>
                        </div>
                        <div class="flex-shrink-0">
                            <% if (t.status === 'Todo') { %>
                                <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-bold bg-amber-100 text-amber-800">
                                    Todo
                                </span>
                            <% } else if (t.status === 'On Progress') { %>
                                <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-bold bg-blue-100 text-blue-800">
                                    On Progress
                                </span>
                            <% } else if (t.status === 'Done') { %>
                                <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-bold bg-green-100 text-green-800">
                                    Done
                                </span>
                            <% } %>
                        </div>
                    </div>

                    <% if (t.foto) { %>
                        <div class="relative w-full aspect-video rounded-xl overflow-hidden border border-border cursor-pointer group" onclick="showTaskPhoto('<%= t.foto %>', '<%= t.task %>')">
                            <img class="w-full h-full object-cover" src="<%= t.foto %>" alt="Lampiran Foto Tugas">
                            <div class="absolute inset-0 bg-black/25 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity">
                                <span class="px-3 py-1.5 bg-white/20 backdrop-blur-md text-white text-[10px] font-semibold rounded-lg border border-white/30">Lihat Fullscreen</span>
                            </div>
                        </div>
                    <% } %>

                    <div class="bg-inputBg/40 border border-border/60 rounded-xl p-3">
                        <span class="block text-[10px] uppercase font-bold tracking-wider text-muted mb-1">Assignee</span>
                        <div class="flex items-center -space-x-2">
                            <% if (t.assignees) { %>
                                <% t.assignees.split(', ').forEach(name => { %>
                                    <div class="w-8 h-8 rounded-full bg-accentLight border-2 border-card flex items-center justify-center text-[10px] font-bold text-accent cursor-pointer" title="<%= name %>">
                                        <%= getInitials(name) %>
                                    </div>
                                <% }) %>
                            <% } else { %>
                                <span class="text-xs text-muted">Belum di-assign</span>
                            <% } %>
                        </div>
                    </div>

                    <div class="flex items-center justify-end gap-2 pt-2 border-t border-border/40">
                        <button onclick="openDetail(this)" data-task="<%= encodeURIComponent(JSON.stringify(t)) %>" class="flex items-center gap-1 px-3 py-1.5 bg-inputBg text-muted text-xs font-semibold rounded-lg hover:bg-border transition-colors">
                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
                            Detail
                        </button>
                        <button onclick="openEdit(this)" data-task="<%= encodeURIComponent(JSON.stringify(t)) %>" class="flex items-center gap-1 px-3 py-1.5 bg-inputBg text-muted text-xs font-semibold rounded-lg hover:bg-border transition-colors">
                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
                            Edit
                        </button>
                        <button onclick="openDelete(this)" data-task="<%= encodeURIComponent(JSON.stringify(t)) %>" class="flex items-center gap-1 px-3 py-1.5 bg-accent/10 text-accent text-xs font-semibold rounded-lg hover:bg-accentLight transition-colors">
                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                            Hapus
                        </button>
                    </div>
                </div>
            <% }) %>
        <% } %>
    </div>

    <!-- Empty State for filtered mobile results -->
    <div id="mobileEmptyState" class="hidden md:hidden bg-card rounded-2xl border border-border p-8 text-center shadow-sm mb-6 animate-fadeInUp">
        <svg class="w-12 h-12 mx-auto text-border mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
        </svg>
        <p class="text-muted text-sm">Tidak ada tugas yang sesuai dengan filter.</p>
    </div>

    <!-- Pagination Controls -->
    <div id="paginationContainer" class="flex items-center justify-between mt-6 px-4 py-3 bg-card border border-border rounded-2xl shadow-sm animate-fadeInUp">
        <div class="flex flex-1 justify-between sm:hidden">
            <button id="prevMobileBtn" class="relative inline-flex items-center rounded-xl border border-border bg-inputBg px-4 py-2 text-sm font-medium text-fg hover:bg-border transition-colors">Previous</button>
            <button id="nextMobileBtn" class="relative ml-3 inline-flex items-center rounded-xl border border-border bg-inputBg px-4 py-2 text-sm font-medium text-fg hover:bg-border transition-colors">Next</button>
        </div>
        <div class="hidden sm:flex sm:flex-1 sm:items-center sm:justify-between">
            <div>
                <p class="text-sm text-muted">
                    Menampilkan <span class="font-bold text-fg" id="pageStart">1</span> - <span class="font-bold text-fg" id="pageEnd">10</span> dari <span class="font-bold text-fg" id="totalCount">0</span> data
                </p>
            </div>
            <div>
                <nav class="isolate inline-flex -space-x-px rounded-xl shadow-sm bg-inputBg border border-border p-1 gap-1" aria-label="Pagination" id="pageNumbersContainer">
                    <!-- Dynamic page numbers -->
                </nav>
            </div>
        </div>
    </div>
</main>

<!-- Add Modal -->
<div id="addModal" class="fixed inset-0 bg-black/50 z-50 flex items-center justify-center p-4 hidden opacity-0 transition-opacity duration-300 overflow-y-auto">
    <div class="bg-card rounded-2xl p-6 max-w-md w-full shadow-xl transform scale-95 transition-transform duration-300 my-auto" id="addModalContent">
        <div class="flex items-center justify-between mb-6">
            <h3 class="font-display text-xl font-bold text-fg">Tambah Task</h3>
            <button type="button" onclick="closeAddModal()" class="text-muted hover:text-fg transition-colors">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
            </button>
        </div>
        <form action="/task-management/add" method="POST" class="space-y-4">
            <div>
                <label class="block text-sm font-semibold text-fg mb-2">Tugas / Task</label>
                <textarea name="task" required rows="3" class="w-full px-4 py-2.5 bg-inputBg border border-border rounded-xl text-fg focus:border-accent transition-colors text-sm resize-none" placeholder="Nama atau deskripsi tugas"></textarea>
            </div>
            <div class="grid grid-cols-2 gap-4">
                <div>
                    <label class="block text-sm font-semibold text-fg mb-2">Tanggal Mulai</label>
                    <input type="date" name="tanggal" required class="w-full px-4 py-2.5 bg-inputBg border border-border rounded-xl text-fg focus:border-accent transition-colors text-sm">
                </div>
                <div>
                    <label class="block text-sm font-semibold text-fg mb-2">Deadline</label>
                    <input type="date" name="deadline" required class="w-full px-4 py-2.5 bg-inputBg border border-border rounded-xl text-fg focus:border-accent transition-colors text-sm">
                </div>
            </div>
            <div>
                <label class="block text-sm font-semibold text-fg mb-2">Status</label>
                <select name="status" required class="w-full px-4 py-2.5 bg-inputBg border border-border rounded-xl text-fg appearance-none cursor-pointer focus:border-accent transition-colors text-sm">
                    <option value="Todo" selected>Todo</option>
                    <option value="On Progress">On Progress</option>
                    <option value="Done">Done</option>
                </select>
            </div>
            <div>
                <label class="block text-sm font-semibold text-fg mb-2">Assign Student Staff</label>
                <div class="grid grid-cols-1 gap-2 max-h-36 overflow-y-auto p-3 bg-inputBg border border-border rounded-xl hide-scrollbar">
                    <% if (karyawanList && karyawanList.length === 0) { %>
                        <p class="text-xs text-muted text-center py-2">Belum ada student staff. Tambah terlebih dahulu.</p>
                    <% } else if (karyawanList) { %>
                        <% karyawanList.forEach(k => { %>
                            <label class="flex items-center gap-3 p-2 hover:bg-card/75 rounded-lg cursor-pointer transition-colors text-sm font-medium text-fg">
                                <input type="checkbox" name="assignees" value="<%= k.id %>" class="w-4 h-4 text-accent border-border rounded focus:ring-accent">
                                <div class="w-8 h-8 rounded-full bg-accentLight flex items-center justify-center text-[10px] font-bold text-accent flex-shrink-0">
                                    <%= getInitials(k.nama) %>
                                </div>
                                <span class="truncate"><%= k.nama %></span>
                            </label>
                        <% }) %>
                    <% } %>
                </div>
            </div>
            <div>
                <label class="block text-sm font-semibold text-fg mb-2">Foto Lampiran (Opsional)</label>
                <div class="flex items-center justify-center w-full">
                    <label for="taskImageInput" class="flex flex-col items-center justify-center w-full h-24 border-2 border-dashed rounded-xl cursor-pointer bg-inputBg border-border hover:bg-border transition-colors">
                        <div class="flex flex-col items-center justify-center pt-2 pb-2 text-center">
                            <svg class="w-6 h-6 mb-1 text-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"></path></svg>
                            <p class="text-xs text-muted font-semibold">Klik untuk unggah gambar</p>
                        </div>
                        <input id="taskImageInput" type="file" accept="image/*" class="hidden" />
                    </label>
                </div>
                <img id="taskImagePreview" class="hidden w-full rounded-xl mt-3 aspect-video border border-border object-cover max-h-40" alt="Pratinjau Foto">
                <input type="hidden" name="foto" id="taskFotoInput">
            </div>
            <div class="mt-6 pt-4 border-t border-border flex justify-end gap-3">
                <button type="button" onclick="closeAddModal()" class="px-5 py-2.5 bg-inputBg text-muted font-semibold rounded-xl hover:bg-border transition-colors text-sm">Batal</button>
                <button type="submit" class="px-5 py-2.5 bg-accent text-white font-medium rounded-xl hover:bg-accentHover transition-colors text-sm">Simpan</button>
            </div>
        </form>
    </div>
</div>

<!-- Edit Modal -->
<div id="editModal" class="fixed inset-0 bg-black/50 z-50 flex items-center justify-center p-4 hidden opacity-0 transition-opacity duration-300 overflow-y-auto">
    <div class="bg-card rounded-2xl p-6 max-w-md w-full shadow-xl transform scale-95 transition-transform duration-300 my-auto" id="editModalContent">
        <div class="flex items-center justify-between mb-6">
            <h3 class="font-display text-xl font-bold text-fg">Edit Task</h3>
            <button type="button" onclick="closeEditModal()" class="text-muted hover:text-fg transition-colors">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
            </button>
        </div>
        <form action="/task-management/edit" method="POST" class="space-y-4">
            <input type="hidden" name="id" id="editId">
            <div>
                <label class="block text-sm font-semibold text-fg mb-2">Tugas / Task</label>
                <textarea name="task" id="editTask" required rows="3" class="w-full px-4 py-2.5 bg-inputBg border border-border rounded-xl text-fg focus:border-accent transition-colors text-sm resize-none" placeholder="Nama atau deskripsi tugas"></textarea>
            </div>
            <div class="grid grid-cols-2 gap-4">
                <div>
                    <label class="block text-sm font-semibold text-fg mb-2">Tanggal Mulai</label>
                    <input type="date" name="tanggal" id="editTanggal" required class="w-full px-4 py-2.5 bg-inputBg border border-border rounded-xl text-fg focus:border-accent transition-colors text-sm">
                </div>
                <div>
                    <label class="block text-sm font-semibold text-fg mb-2">Deadline</label>
                    <input type="date" name="deadline" id="editDeadline" required class="w-full px-4 py-2.5 bg-inputBg border border-border rounded-xl text-fg focus:border-accent transition-colors text-sm">
                </div>
            </div>
            <div>
                <label class="block text-sm font-semibold text-fg mb-2">Status</label>
                <select name="status" id="editStatus" required class="w-full px-4 py-2.5 bg-inputBg border border-border rounded-xl text-fg appearance-none cursor-pointer focus:border-accent transition-colors text-sm">
                    <option value="Todo">Todo</option>
                    <option value="On Progress">On Progress</option>
                    <option value="Done">Done</option>
                </select>
            </div>
            <div>
                <label class="block text-sm font-semibold text-fg mb-2">Assign Student Staff</label>
                <div class="grid grid-cols-1 gap-2 max-h-36 overflow-y-auto p-3 bg-inputBg border border-border rounded-xl hide-scrollbar">
                    <% if (karyawanList && karyawanList.length === 0) { %>
                        <p class="text-xs text-muted text-center py-2">Belum ada student staff. Tambah terlebih dahulu.</p>
                    <% } else if (karyawanList) { %>
                        <% karyawanList.forEach(k => { %>
                            <label class="flex items-center gap-3 p-2 hover:bg-card/75 rounded-lg cursor-pointer transition-colors text-sm font-medium text-fg">
                                <input type="checkbox" name="assignees" value="<%= k.id %>" class="edit-assignee-checkbox w-4 h-4 text-accent border-border rounded focus:ring-accent">
                                <div class="w-8 h-8 rounded-full bg-accentLight flex items-center justify-center text-[10px] font-bold text-accent flex-shrink-0">
                                    <%= getInitials(k.nama) %>
