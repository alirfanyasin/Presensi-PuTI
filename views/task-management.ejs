<!-- Detail Modal -->
<div id="detailModal" class="fixed inset-0 bg-black/50 z-50 flex items-center justify-center p-4 hidden opacity-0 transition-opacity duration-300 overflow-y-auto" onclick="closeDetailModal()">
    <div class="bg-card rounded-2xl p-6 sm:p-8 max-w-3xl w-full shadow-2xl transform scale-95 transition-transform duration-300 my-auto text-left" id="detailModalContent" onclick="event.stopPropagation()">
        <div class="flex items-center justify-between pb-4 border-b border-border mb-6">
            <div class="flex items-center gap-3">
                <div class="p-2 bg-accent/10 text-accent rounded-xl">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/></svg>
                </div>
                <h3 class="font-display text-xl sm:text-2xl font-bold text-fg flex items-center gap-2">
                    <span>Detail Tugas / Task</span>
                    <span id="detailTaskCode" class="font-mono text-xs sm:text-sm font-bold text-white bg-accent px-2.5 py-0.5 rounded-lg"></span>
                </h3>
            </div>
            <button type="button" onclick="closeDetailModal()" class="text-muted hover:text-fg transition-colors p-1.5 hover:bg-inputBg rounded-lg">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
            </button>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            <!-- Left side: Task description & Details -->
            <div class="md:col-span-2 space-y-6">
                <div>
                    <h4 class="text-xs uppercase font-bold tracking-wider text-muted mb-2">Deskripsi Tugas</h4>
                    <div class="bg-inputBg/40 border border-border/60 rounded-2xl p-4 sm:p-5 text-sm text-fg font-medium whitespace-pre-wrap break-all leading-relaxed max-h-[40vh] overflow-y-auto" id="detailTaskDescription"></div>
                </div>

                <div class="grid grid-cols-2 gap-4">
                    <div class="bg-inputBg/40 border border-border/60 rounded-2xl p-4">
                        <span class="block text-xs font-bold text-muted uppercase tracking-wider mb-1">Tanggal Mulai</span>
                        <span class="text-sm font-semibold text-fg" id="detailStartDate"></span>
                    </div>
                    <div class="bg-inputBg/40 border border-border/60 rounded-2xl p-4">
                        <span class="block text-xs font-bold text-accent uppercase tracking-wider mb-1">Deadline</span>
                        <span class="text-sm font-bold text-accent" id="detailDeadline"></span>
                    </div>
                </div>

                <div>
                    <h4 class="text-xs uppercase font-bold tracking-wider text-muted mb-2">Status Tugas</h4>
                    <div id="detailStatusBadge" class="inline-flex"></div>
                </div>
            </div>

            <!-- Right side: Assignees & Attachment -->
            <div class="space-y-6">
                <div>
                    <h4 class="text-xs uppercase font-bold tracking-wider text-muted mb-3">Didelegasikan Kepada</h4>
                    <div class="bg-inputBg/40 border border-border/60 rounded-2xl p-4 space-y-3 max-h-48 overflow-y-auto" id="detailAssigneeList">
                        <!-- Dynamically filled -->
                    </div>
                </div>

                <div id="detailAttachmentSection">
                    <h4 class="text-xs uppercase font-bold tracking-wider text-muted mb-3">Foto Lampiran</h4>
                    <div class="relative aspect-video rounded-2xl overflow-hidden border border-border cursor-pointer group" id="detailImageWrapper">
                        <img id="detailImagePreview" class="w-full h-full object-cover" src="" alt="Lampiran Foto Tugas">
                        <div class="absolute inset-0 bg-black/45 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity">
                            <span class="px-3 py-1.5 bg-white/20 backdrop-blur-md text-white text-xs font-semibold rounded-xl border border-white/30">Lihat Fullscreen</span>
                        </div>
                    </div>
                </div>
