<%- include('partials/header', { title: 'Presensi' }) %>
<%- include('partials/nav', { path: '/' }) %>

    <main class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-6 sm:py-12">
        <div id="pageForm">
            <!-- Page Header -->
            <div class="mb-6 sm:mb-8 animate-fadeInUp stagger-1 text-center sm:text-left">
                <h2 class="font-display text-2xl sm:text-4xl font-bold text-fg mb-2">Presensi Harian</h2>
                <p class="text-sm sm:text-base text-muted">Catat kehadiran dan pekerjaan Anda hari ini</p>
            </div>

            <div class="grid lg:grid-cols-3 gap-6 sm:gap-8">
                <!-- Form Card -->
                <div class="lg:col-span-2 animate-fadeInUp stagger-2">
                    <div class="bg-card rounded-2xl border border-border p-5 sm:p-8 card-hover shadow-sm">
                        <form action="/presensi" method="POST" class="space-y-5 sm:space-y-6">
                            <!-- Nama Field -->
                            <div class="form-group">
                                <label for="karyawanId" class="block text-sm font-semibold text-fg mb-2">Nama Karyawan</label>
                                <select id="karyawanId" name="karyawanId" required class="w-full px-4 py-3 bg-inputBg border border-border rounded-xl text-fg appearance-none cursor-pointer focus:border-accent transition-colors">
                                    <option value="" disabled selected>Pilih nama Anda</option>
                                    <% karyawanList.forEach(k => { %>
                                        <option value="<%= k.id %>"><%= k.nama %></option>
                                    <% }) %>
                                </select>
                            </div>

                            <!-- Tanggal Field -->
                            <div class="form-group">
                                <label for="tanggal" class="block text-sm font-semibold text-fg mb-2">Tanggal</label>
                                <input type="date" id="tanggal" name="tanggal" required readonly value="<%= today %>" class="w-full px-4 py-3 bg-gray-100 border border-border rounded-xl text-muted text-sm cursor-not-allowed pointer-events-none">
                            </div>
                            <div class="form-group hidden" id="hariContainer">
                                <label class="block text-sm font-semibold text-fg mb-2">Hari</label>
                                <input type="text" id="displayHari" readonly disabled class="w-full px-4 py-3 bg-gray-100 border border-border rounded-xl text-muted text-sm cursor-not-allowed">
                            </div>

                            <!-- Time Fields -->
                            <div class="grid grid-cols-2 gap-4">
                                <div class="form-group">
                                    <label for="jamMulai" class="block text-sm font-semibold text-fg mb-2">Jam Mulai</label>
                                    <input type="time" id="jamMulai" name="jamMulai" required class="w-full px-4 py-3 bg-inputBg border border-border rounded-xl text-fg focus:border-accent transition-colors">
                                </div>
                                <div class="form-group">
                                    <label for="jamAkhir" class="block text-sm font-semibold text-fg mb-2">Jam Akhir</label>
                                    <input type="time" id="jamAkhir" name="jamAkhir" required class="w-full px-4 py-3 bg-inputBg border border-border rounded-xl text-fg focus:border-accent transition-colors">
                                </div>
                            </div>
                            <div class="form-group hidden" id="totalJamContainer">
                                <label class="block text-sm font-semibold text-fg mb-2">Total Jam</label>
                                <input type="text" id="displayTotalJam" readonly disabled class="w-full px-4 py-3 bg-gray-100 border border-border rounded-xl text-muted text-sm cursor-not-allowed">
                            </div>

                            <!-- Pekerjaan Field -->
                            <div class="form-group">
                                <label for="pekerjaan" class="block text-sm font-semibold text-fg mb-2">Deskripsi Pekerjaan</label>
                                <textarea id="pekerjaan" name="pekerjaan" rows="4" required placeholder="Tuliskan pekerjaan yang telah dilakukan..." class="w-full px-4 py-3 bg-inputBg border border-border rounded-xl text-fg placeholder-muted resize-none focus:border-accent transition-colors"></textarea>
                                <p class="mt-1 text-xs text-muted"><span id="charCount">0</span>/500 karakter</p>
                            </div>

                            <!-- Camera / Photo Proof Field -->
                            <div class="form-group border border-border/60 bg-accentLighter/10 rounded-2xl p-4 sm:p-5">
                                <label class="block text-sm font-semibold text-fg mb-2 flex items-center gap-2">
                                    <svg class="w-5 h-5 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
                                    Foto Bukti Kehadiran
                                </label>
                                <p class="text-xs text-muted mb-4">Ambil foto selfie/kehadiran Anda untuk melengkapi bukti pekerjaan.</p>

                                <div class="relative overflow-hidden rounded-xl border border-border bg-inputBg aspect-video max-w-md mx-auto flex flex-col items-center justify-center transition-all duration-300" id="cameraContainer">
                                    <!-- Camera Placeholder / Start Button -->
                                    <div id="cameraPlaceholder" class="flex flex-col items-center justify-center p-6 text-center z-10 w-full h-full">
                                        <div class="w-14 h-14 bg-accentLight/60 rounded-full flex items-center justify-center mb-3">
                                            <svg class="w-7 h-7 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
                                        </div>
                                        <button type="button" id="startCameraBtn" class="px-5 py-2.5 bg-accent text-white text-xs font-semibold rounded-xl hover:bg-accentHover transition-colors btn-press">
                                            Aktifkan Kamera
                                        </button>
                                    </div>

                                    <!-- Video Element -->
                                    <video id="video" autoplay playsinline class="hidden w-full h-full object-cover" style="transform: scaleX(-1);"></video>

                                    <!-- Captured Image Preview -->
                                    <img id="photoPreview" class="hidden w-full h-full object-cover" alt="Pratinjau foto bukti">

                                    <!-- Canvas (Hidden) -->
                                    <canvas id="canvas" class="hidden"></canvas>

                                    <!-- Camera Overlay / Controls (on camera active) -->
                                    <div id="cameraControls" class="absolute bottom-4 left-0 right-0 flex justify-center gap-3 hidden z-20">
                                        <button type="button" id="captureBtn" class="w-12 h-12 bg-white text-accent rounded-full flex items-center justify-center shadow-lg hover:scale-105 transition-transform border-4 border-accent focus:outline-none" title="Ambil Foto">
                                            <div class="w-6 h-6 bg-accent rounded-full"></div>
                                        </button>
                                    </div>
                                </div>

                                <!-- Post-capture Controls -->
                                <div id="postCaptureControls" class="flex justify-center gap-3 mt-4 hidden">
                                    <button type="button" id="retakeBtn" class="inline-flex items-center gap-1.5 px-4 py-2 bg-inputBg text-muted text-xs font-semibold rounded-xl hover:bg-border transition-colors border border-border">
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 1121.21 8H18.22"/></svg>
                                        Foto Ulang
                                    </button>
                                </div>

                                <!-- Hidden Input to Store base64 data -->
                                <input type="hidden" name="foto" id="fotoInput">
                                <!-- Fallback Input for mobile camera / non-secure contexts -->
                                <input type="file" accept="image/*" capture="user" id="cameraFallbackInput" class="hidden">
                            </div>

                            <!-- Submit Button -->
                            <div class="flex flex-col sm:flex-row gap-3 pt-2">
                                <button type="submit" class="w-full sm:flex-1 inline-flex items-center justify-center gap-2 px-6 py-3 bg-accent text-white font-semibold rounded-xl hover:bg-accentHover transition-all btn-press focus:ring-2 focus:ring-accent focus:ring-offset-2">
                                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                                    Simpan Presensi
                                </button>
                                <a href="/" class="w-full sm:w-auto px-6 py-3 bg-inputBg text-muted text-center font-medium rounded-xl hover:bg-border transition-colors btn-press">Reset Form</a>
                            </div>
                        </form>
                    </div>
                </div>

                <!-- Side Panel -->
                <div class="space-y-6 animate-fadeInUp stagger-3">
                    <div class="bg-card rounded-2xl border border-border p-5 sm:p-6 card-hover shadow-sm">
                        <h3 class="font-display text-lg font-bold text-fg mb-4">Statistik Hari Ini</h3>
                        <div class="space-y-4">
                            <div class="flex items-center justify-between p-3 bg-inputBg rounded-xl">
                                <div class="flex items-center gap-3">
                                    <div class="w-10 h-10 bg-accentLight rounded-lg flex items-center justify-center">
                                        <svg class="w-5 h-5 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/></svg>
                                    </div>
                                    <span class="text-sm font-medium text-fg">Total Hadir</span>
                                </div>
                                <span class="text-2xl font-bold text-accent"><%= stats.totalHadir %></span>
                            </div>
                            <div class="flex items-center justify-between p-3 bg-inputBg rounded-xl">
                                <div class="flex items-center gap-3">
                                    <div class="w-10 h-10 bg-green-100 rounded-lg flex items-center justify-center">
                                        <svg class="w-5 h-5 text-success" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                                    </div>
                                    <span class="text-sm font-medium text-fg">Total Jam</span>
                                </div>
                                <span class="text-2xl font-bold text-success"><%= stats.hours %>h <%= stats.minutes > 0 ? stats.minutes + 'm' : '' %></span>
                            </div>
                        </div>
                    </div>
                    <div class="bg-card rounded-2xl border border-border p-5 sm:p-6 card-hover shadow-sm">
                        <h3 class="font-display text-lg font-bold text-fg mb-4">Aktivitas Terbaru</h3>
                        <div class="space-y-3">
                            <% if (recent.length === 0) { %>
                                <p class="text-sm text-muted text-center py-4">Belum ada presensi hari ini</p>
                            <% } else { %>
                                <% recent.forEach(p => { %>
                                    <div class="flex items-center gap-3 p-3 bg-inputBg rounded-xl animate-slideIn">
                                        <div class="w-8 h-8 bg-accentLight rounded-full flex items-center justify-center flex-shrink-0">
                                            <span class="text-xs font-bold text-accent"><%= p.nama.charAt(0) %></span>
                                        </div>
                                        <div class="flex-1 min-w-0">
                                            <p class="text-sm font-medium text-fg truncate"><%= p.nama %></p>
                                            <p class="text-xs text-muted"><%= p.jamMulai %> - <%= p.jamAkhir %></p>
                                        </div>
                                    </div>
                                <% }) %>
                            <% } %>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <% if (typeof success !== 'undefined') { %>
    <div id="toast" class="toast fixed top-20 right-4 left-4 sm:left-auto sm:right-4 px-6 py-4 rounded-xl shadow-lg flex items-center gap-3 z-50 bg-success text-white show">
        <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
        <span class="text-sm sm:text-base"><%= success %></span>
    </div>
    <script>
        setTimeout(() => document.getElementById('toast').classList.remove('show'), 3000);
    </script>
    <% } %>

    <script>
        const pekerjaanTextarea = document.getElementById('pekerjaan');
        const charCount = document.getElementById('charCount');
        const jamMulaiInput = document.getElementById('jamMulai');
        const jamAkhirInput = document.getElementById('jamAkhir');
        const tanggalInput = document.getElementById('tanggal');
        const hariContainer = document.getElementById('hariContainer');
        const displayHari = document.getElementById('displayHari');
        const totalJamContainer = document.getElementById('totalJamContainer');
        const displayTotalJam = document.getElementById('displayTotalJam');

        const hariNames = ["Minggu", "Senin", "Selasa", "Rabu", "Kamis", "Jumat", "Sabtu"];

        pekerjaanTextarea.addEventListener('input', function() {
            const length = this.value.length;
            charCount.textContent = length;
            charCount.classList.toggle('text-red-500', length > 500);
        });

        function calculateHari() {
            if (tanggalInput.value) {
                const d = new Date(tanggalInput.value);
                if (!isNaN(d.getTime())) {
                    displayHari.value = hariNames[d.getDay()];
                    hariContainer.classList.remove('hidden');
                } else {
                    hariContainer.classList.add('hidden');
                }
            } else {
                hariContainer.classList.add('hidden');
            }
        }

        function validateTime() {
            const jamMulai = jamMulaiInput.value;
            const jamAkhir = jamAkhirInput.value;
            if (jamMulai && jamAkhir) {
                if (jamAkhir <= jamMulai) {
                    jamAkhirInput.setCustomValidity('Jam akhir harus lebih besar dari jam mulai');
                    jamAkhirInput.reportValidity();
                    totalJamContainer.classList.add('hidden');
                } else {
                    jamAkhirInput.setCustomValidity('');
                    const [hM, mM] = jamMulai.split(':').map(Number);
                    const [hA, mA] = jamAkhir.split(':').map(Number);
                    const totalMins = (hA * 60 + mA) - (hM * 60 + mM);
                    const hours = Math.floor(totalMins / 60);
                    const mins = totalMins % 60;
                    let text = '';
                    if (hours > 0) text += hours + ' Jam ';
                    if (mins > 0) text += mins + ' Menit';
                    displayTotalJam.value = text.trim();
                    totalJamContainer.classList.remove('hidden');
                }
            } else {
                jamAkhirInput.setCustomValidity('');
                totalJamContainer.classList.add('hidden');
            }
        }

        jamAkhirInput.addEventListener('change', validateTime);
        jamMulaiInput.addEventListener('change', validateTime);
        tanggalInput.addEventListener('change', calculateHari);

        // Initialize day on page load
        calculateHari();

        // --- CAMERA INTEGRATION CODE ---
        const startCameraBtn = document.getElementById('startCameraBtn');
        const captureBtn = document.getElementById('captureBtn');
        const retakeBtn = document.getElementById('retakeBtn');
        const video = document.getElementById('video');
        const canvas = document.getElementById('canvas');
        const photoPreview = document.getElementById('photoPreview');
        const fotoInput = document.getElementById('fotoInput');
        const cameraPlaceholder = document.getElementById('cameraPlaceholder');
        const cameraControls = document.getElementById('cameraControls');
        const postCaptureControls = document.getElementById('postCaptureControls');
        const cameraContainer = document.getElementById('cameraContainer');
        const cameraFallbackInput = document.getElementById('cameraFallbackInput');

        // Check if webcam camera is supported & in secure context
        const isSecure = window.isSecureContext || (window.location.protocol === 'https:' || window.location.hostname === 'localhost' || window.location.hostname === '127.0.0.1');
        const canUseWebcam = !!(navigator.mediaDevices && navigator.mediaDevices.getUserMedia) && isSecure;

        if (!canUseWebcam) {
            // Update UI/button for hybrid fallback (mobile native camera)
            if (startCameraBtn) {
                startCameraBtn.innerHTML = `
                    <svg class="w-4 h-4 mr-1.5 inline-block" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
                    Buka Kamera HP
                `;
            }
            const descText = document.querySelector('#cameraPlaceholder + p') || document.querySelector('.form-group p.text-muted');
            if (descText) {
                descText.textContent = 'Klik tombol di bawah untuk mengambil foto selfie/kehadiran langsung menggunakan kamera HP Anda.';
            }
        }

        let cameraStream = null;

        async function startCamera() {
            if (!canUseWebcam) {
                // Non-secure context / Safari or Chrome on iOS sandbox -> Fallback to native system camera
                if (cameraFallbackInput) {
                    cameraFallbackInput.click();
                }
                return;
            }

            try {
                // Clear any existing stream
                stopCamera();

                cameraStream = await navigator.mediaDevices.getUserMedia({
                    video: {
                        facingMode: 'user',
                        width: { ideal: 640 },
                        height: { ideal: 480 }
                    },
                    audio: false
                });

                video.srcObject = cameraStream;
                video.classList.remove('hidden');
                cameraPlaceholder.classList.add('hidden');
                photoPreview.classList.add('hidden');
                cameraControls.classList.remove('hidden');
                postCaptureControls.classList.add('hidden');
                
                // Clear the hidden input
                fotoInput.value = '';
            } catch (error) {
                console.error('Camera access error:', error);
                
                // Fallback automatically if browser webcam fails
                if (cameraFallbackInput) {
                    cameraFallbackInput.click();
                }
            }
        }

        function stopCamera() {
            if (cameraStream) {
                cameraStream.getTracks().forEach(track => track.stop());
                cameraStream = null;
            }
        }

        if (startCameraBtn) {
            startCameraBtn.addEventListener('click', startCamera);
        }

        if (cameraFallbackInput) {
            cameraFallbackInput.addEventListener('change', function(e) {
                const file = e.target.files[0];
                if (!file) return;

                const reader = new FileReader();
                reader.onload = function(event) {
                    const img = new Image();
                    img.onload = function() {
                        // Draw to canvas to compress & standardize dimensions
                        const maxW = 640;
                        const maxH = 480;
                        let w = img.width;
                        let h = img.height;

                        if (w > maxW || h > maxH) {
                            const ratio = Math.min(maxW / w, maxH / h);
                            w = Math.round(w * ratio);
                            h = Math.round(h * ratio);
                        }

                        canvas.width = w;
                        canvas.height = h;
                        const ctx = canvas.getContext('2d');
                        
                        // Scale and draw normally (static photo does not need mirroring)
                        ctx.drawImage(img, 0, 0, w, h);

                        // Compress & ensure it is well below 1MB
                        let quality = 0.8;
                        let dataUrl = canvas.toDataURL('image/jpeg', quality);
                        while (dataUrl.length * 0.75 > 900 * 1024 && quality > 0.1) {
                            quality -= 0.1;
                            dataUrl = canvas.toDataURL('image/jpeg', quality);
                        }
                        fotoInput.value = dataUrl;

                        // Show preview
                        photoPreview.src = dataUrl;
                        photoPreview.classList.remove('hidden');
                        
                        cameraPlaceholder.classList.add('hidden');
                        video.classList.add('hidden');
                        cameraControls.classList.add('hidden');
                        postCaptureControls.classList.remove('hidden');
                    };
                    img.src = event.target.result;
                };
                reader.readAsDataURL(file);
            });
        }

        if (captureBtn) {
            captureBtn.addEventListener('click', function() {
                if (!video.srcObject) return;

                // Match canvas dimensions to video
                canvas.width = video.videoWidth || 640;
                canvas.height = video.videoHeight || 480;

                const ctx = canvas.getContext('2d');
                // Mirror image for front camera selfie feel
                ctx.translate(canvas.width, 0);
                ctx.scale(-1, 1);
                
                ctx.drawImage(video, 0, 0, canvas.width, canvas.height);

                // Compress & ensure it is well below 1MB
                let quality = 0.8;
                let dataUrl = canvas.toDataURL('image/jpeg', quality);
                while (dataUrl.length * 0.75 > 900 * 1024 && quality > 0.1) {
                    quality -= 0.1;
                    dataUrl = canvas.toDataURL('image/jpeg', quality);
                }
                fotoInput.value = dataUrl;

                // Show preview
                photoPreview.src = dataUrl;
                photoPreview.classList.remove('hidden');
                
                // Hide video & controls
                video.classList.add('hidden');
                cameraControls.classList.add('hidden');
                postCaptureControls.classList.remove('hidden');

                // Turn off camera stream
                stopCamera();
            });
        }

        if (retakeBtn) {
            retakeBtn.addEventListener('click', function() {
                fotoInput.value = '';
                photoPreview.classList.add('hidden');
                photoPreview.src = '';
                if (cameraFallbackInput) {
                    cameraFallbackInput.value = '';
                }
                startCamera();
            });
        }

        // Safe cleanup: stop camera if user submits form or leaves page
        const presensiForm = document.querySelector('form');
        if (presensiForm) {
            presensiForm.addEventListener('submit', function() {
                stopCamera();
            });
        }
    </script>
</body>
</html>
