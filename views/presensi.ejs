<%- include('partials/header', { title: 'Presensi' }) %>
<%- include('partials/nav', { path: '/' }) %>

    <main class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-6 sm:py-12">
        <div id="pageForm">
            <!-- Page Header -->
            <div class="mb-6 sm:mb-8 animate-fadeInUp stagger-1 text-center sm:text-left">
                <h2 class="font-display text-2xl sm:text-4xl font-bold text-fg mb-2">Presensi Harian</h2>
                <p class="text-sm sm:text-base text-muted">Catat kehadiran dan pekerjaan Anda hari ini</p>
            </div>

            <div class="grid lg:grid-cols-3 gap-6 sm:gap-8">
                <!-- Form Card -->
                <div class="lg:col-span-2 animate-fadeInUp stagger-2">
                    <div class="bg-card rounded-2xl border border-border p-5 sm:p-8 card-hover shadow-sm">
                        <form action="/presensi-masuk" method="POST" class="space-y-5 sm:space-y-6" id="presensiForm">
                            <!-- Nama Field -->
                            <div class="form-group">
                                <label for="karyawanId" class="block text-sm font-semibold text-fg mb-2">Nama Karyawan</label>
                                <select id="karyawanId" name="karyawanId" required class="w-full px-4 py-3 bg-inputBg border border-border rounded-xl text-fg appearance-none cursor-pointer focus:border-accent transition-colors">
                                    <option value="" disabled selected>Pilih nama Anda</option>
                                    <% karyawanList.forEach(k => { %>
                                        <option value="<%= k.id %>"><%= k.nama %></option>
                                    <% }) %>
                                </select>
                            </div>

                            <!-- Tanggal Field -->
                            <div class="form-group">
                                <label for="tanggal" class="block text-sm font-semibold text-fg mb-2">Tanggal</label>
                                <input type="date" id="tanggal" name="tanggal" required readonly value="<%= today %>" class="w-full px-4 py-3 bg-gray-100 border border-border rounded-xl text-muted text-sm cursor-not-allowed pointer-events-none">
                            </div>
                            <div class="form-group hidden" id="hariContainer">
                                <label class="block text-sm font-semibold text-fg mb-2">Hari</label>
                                <input type="text" id="displayHari" readonly disabled class="w-full px-4 py-3 bg-gray-100 border border-border rounded-xl text-muted text-sm cursor-not-allowed">
                            </div>

                            <!-- Status Presensi Info (muncul setelah pilih nama) -->
                            <div id="statusInfo" class="hidden">
                                <!-- Loading -->
                                <div id="statusLoading" class="hidden flex items-center gap-2 text-muted text-sm py-2">
                                    <svg class="w-4 h-4 animate-spin" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 1121.21 8H18.22"/></svg>
                                    Memeriksa status presensi...
                                </div>
                                <!-- Badge Status -->
                                <div id="statusBadge" class="hidden"></div>
                            </div>

                            <!-- Info Jam Masuk Otomatis -->
                            <div id="waktuMasukInfo" class="hidden">
                                <label class="block text-sm font-semibold text-fg mb-2">Jam Masuk</label>
                                <div class="flex items-center gap-3 px-4 py-3 bg-green-50 border border-green-200 rounded-xl">
                                    <svg class="w-5 h-5 text-green-600 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                                    <div>
                                        <p class="text-sm font-semibold text-green-700">Waktu otomatis dicatat saat Simpan</p>
                                        <p class="text-xs text-green-600 font-mono" id="clockDisplay">--:--:--</p>
                                    </div>
                                </div>
                            </div>

                            <!-- Info Jam Pulang Otomatis -->
                            <div id="waktuPulangInfo" class="hidden">
                                <label class="block text-sm font-semibold text-fg mb-2">Jam Pulang</label>
                                <div class="flex items-center gap-3 px-4 py-3 bg-red-50 border border-red-200 rounded-xl">
                                    <svg class="w-5 h-5 text-red-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                                    <div>
                                        <p class="text-sm font-semibold text-red-600">Waktu otomatis dicatat saat Simpan</p>
                                        <p class="text-xs text-red-500 font-mono" id="clockDisplayPulang">--:--:--</p>
                                    </div>
                                </div>
                            </div>

                            <!-- Deskripsi Pekerjaan (hanya Pulang) -->
                            <div id="pekerjaanSection" class="hidden">
                                <label for="pekerjaan" class="block text-sm font-semibold text-fg mb-2">Deskripsi Pekerjaan <span class="text-accent text-xs">(wajib)</span></label>
                                <textarea id="pekerjaan" name="pekerjaan" rows="4" placeholder="Tuliskan pekerjaan yang telah dilakukan..." class="w-full px-4 py-3 bg-inputBg border border-border rounded-xl text-fg placeholder-muted resize-none focus:border-accent transition-colors"></textarea>
                                <p class="mt-1 text-xs text-muted"><span id="charCount">0</span>/500 karakter</p>
                            </div>

                            <!-- Foto Bukti Kehadiran (hanya Pulang) -->
                            <div id="fotoSection" class="hidden">
                                <div class="form-group border border-border/60 bg-accentLighter/10 rounded-2xl p-4 sm:p-5">
                                    <label class="block text-sm font-semibold text-fg mb-2 flex items-center gap-2">
                                        <svg class="w-5 h-5 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
                                        Foto Bukti Kehadiran <span class="text-accent text-xs">(wajib)</span>
                                    </label>
                                    <p class="text-xs text-muted mb-4">Ambil foto selfie sebagai bukti kehadiran pulang Anda.</p>
                                    <div class="relative overflow-hidden rounded-xl border border-border bg-inputBg aspect-video max-w-md mx-auto flex flex-col items-center justify-center transition-all duration-300" id="cameraContainer">
                                        <div id="cameraPlaceholder" class="flex flex-col items-center justify-center p-6 text-center z-10 w-full h-full">
                                            <div class="w-14 h-14 bg-accentLight/60 rounded-full flex items-center justify-center mb-3">
                                                <svg class="w-7 h-7 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
                                            </div>
                                            <button type="button" id="startCameraBtn" class="px-5 py-2.5 bg-accent text-white text-xs font-semibold rounded-xl hover:bg-accentHover transition-colors btn-press">Aktifkan Kamera</button>
                                        </div>
                                        <video id="video" autoplay playsinline class="hidden w-full h-full object-cover" style="transform: scaleX(-1);"></video>
                                        <img id="photoPreview" class="hidden w-full h-full object-cover" alt="Pratinjau foto bukti">
                                        <canvas id="canvas" class="hidden"></canvas>
                                        <div id="cameraControls" class="absolute bottom-4 left-0 right-0 flex justify-center gap-3 hidden z-20">
                                            <button type="button" id="captureBtn" class="w-12 h-12 bg-white text-accent rounded-full flex items-center justify-center shadow-lg hover:scale-105 transition-transform border-4 border-accent focus:outline-none" title="Ambil Foto">
                                                <div class="w-6 h-6 bg-accent rounded-full"></div>
                                            </button>
                                        </div>
                                    </div>
                                    <div id="postCaptureControls" class="flex justify-center gap-3 mt-4 hidden">
                                        <button type="button" id="retakeBtn" class="inline-flex items-center gap-1.5 px-4 py-2 bg-inputBg text-muted text-xs font-semibold rounded-xl hover:bg-border transition-colors border border-border">
                                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 1121.21 8H18.22"/></svg>
                                            Foto Ulang
                                        </button>
                                    </div>
                                    <input type="hidden" name="foto" id="fotoInput">
                                    <input type="file" accept="image/*" capture="user" id="cameraFallbackInput" class="hidden">
                                </div>
                            </div>

                            <!-- Submit Button -->
                            <div class="flex flex-col sm:flex-row gap-3 pt-2">
                                <button type="submit" id="submitBtn" class="w-full sm:flex-1 inline-flex items-center justify-center gap-2 px-6 py-3 bg-accent text-white font-semibold rounded-xl hover:bg-accentHover transition-all btn-press focus:ring-2 focus:ring-accent focus:ring-offset-2">
                                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                                    Simpan Presensi
                                </button>
                                <a href="/" class="w-full sm:w-auto px-6 py-3 bg-inputBg text-muted text-center font-medium rounded-xl hover:bg-border transition-colors btn-press">Reset Form</a>
                            </div>
                        </form>
                    </div>
                </div>

                <!-- Side Panel -->
                <div class="space-y-6 animate-fadeInUp stagger-3">
                    <div class="bg-card rounded-2xl border border-border p-5 sm:p-6 card-hover shadow-sm">
                        <h3 class="font-display text-lg font-bold text-fg mb-4">Statistik Hari Ini</h3>
                        <div class="space-y-4">
                            <div class="flex items-center justify-between p-3 bg-inputBg rounded-xl">
                                <div class="flex items-center gap-3">
                                    <div class="w-10 h-10 bg-accentLight rounded-lg flex items-center justify-center">
                                        <svg class="w-5 h-5 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/></svg>
                                    </div>
                                    <span class="text-sm font-medium text-fg">Total Hadir</span>
                                </div>
                                <span class="text-2xl font-bold text-accent"><%= stats.totalHadir %></span>
                            </div>
                            <div class="flex items-center justify-between p-3 bg-inputBg rounded-xl">
                                <div class="flex items-center gap-3">
                                    <div class="w-10 h-10 bg-green-100 rounded-lg flex items-center justify-center">
                                        <svg class="w-5 h-5 text-success" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                                    </div>
                                    <span class="text-sm font-medium text-fg">Total Jam</span>
                                </div>
                                <span class="text-2xl font-bold text-success"><%= stats.hours %>h <%= stats.minutes > 0 ? stats.minutes + 'm' : '' %></span>
                            </div>
                        </div>
                    </div>
                    <div class="bg-card rounded-2xl border border-border p-5 sm:p-6 card-hover shadow-sm">
                        <h3 class="font-display text-lg font-bold text-fg mb-4">Aktivitas Terbaru</h3>
                        <div class="space-y-3">
                            <% if (recent.length === 0) { %>
                                <p class="text-sm text-muted text-center py-4">Belum ada presensi hari ini</p>
                            <% } else { %>
                                <% recent.forEach(p => { %>
                                    <div class="flex items-center gap-3 p-3 bg-inputBg rounded-xl animate-slideIn">
                                        <div class="w-8 h-8 bg-accentLight rounded-full flex items-center justify-center flex-shrink-0">
                                            <span class="text-xs font-bold text-accent"><%= p.nama.charAt(0) %></span>
                                        </div>
                                        <div class="flex-1 min-w-0">
                                            <p class="text-sm font-medium text-fg truncate"><%= p.nama %></p>
                                            <p class="text-xs text-muted">
                                                <% if (p.jamPulang) { %>
                                                    <span class="text-green-600 font-semibold">✓ Masuk</span> <%= p.jamMasuk %> → <span class="text-accent font-semibold">Pulang</span> <%= p.jamPulang %>
                                                <% } else { %>
                                                    <span class="text-green-600 font-semibold">✓ Masuk</span> <%= p.jamMasuk %> · <span class="text-orange-500">Belum Pulang</span>
                                                <% } %>
                                            </p>
                                        </div>
                                    </div>
                                <% }) %>
                            <% } %>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <% if (typeof success !== 'undefined') { %>
    <div id="toast" class="toast fixed top-20 right-4 left-4 sm:left-auto sm:right-4 px-6 py-4 rounded-xl shadow-lg flex items-center gap-3 z-50 bg-success text-white show">
        <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
        <span class="text-sm sm:text-base"><%= success %></span>
    </div>
    <script>setTimeout(() => document.getElementById('toast').classList.remove('show'), 3500);</script>
    <% } %>
    <% if (typeof error !== 'undefined') { %>
    <div id="toastError" class="toast fixed top-20 right-4 left-4 sm:left-auto sm:right-4 px-6 py-4 rounded-xl shadow-lg flex items-center gap-3 z-50 bg-accent text-white show">
        <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        <span class="text-sm sm:text-base"><%= error %></span>
    </div>
    <script>setTimeout(() => document.getElementById('toastError').classList.remove('show'), 5000);</script>
    <% } %>

    <script>
        // --- AUTO STATUS DETECTION ---
        const presensiForm = document.getElementById('presensiForm');
        const karyawanSelect = document.getElementById('karyawanId');
        const tanggalInput = document.getElementById('tanggal');
        const hariContainer = document.getElementById('hariContainer');
        const displayHari = document.getElementById('displayHari');
        const waktuMasukInfo = document.getElementById('waktuMasukInfo');
        const waktuPulangInfo = document.getElementById('waktuPulangInfo');
        const pekerjaanSection = document.getElementById('pekerjaanSection');
        const fotoSection = document.getElementById('fotoSection');
        const pekerjaanTextarea = document.getElementById('pekerjaan');
        const charCount = document.getElementById('charCount');
        const statusInfo = document.getElementById('statusInfo');
        const statusLoading = document.getElementById('statusLoading');
        const statusBadge = document.getElementById('statusBadge');
        const submitBtn = document.getElementById('submitBtn');
        const hariNames = ["Minggu", "Senin", "Selasa", "Rabu", "Kamis", "Jumat", "Sabtu"];
        let currentStatus = 'none'; // 'none' | 'sudah_masuk' | 'sudah_pulang'

        // Live clock
        function updateClock() {
            const now = new Date();
            const pad = n => String(n).padStart(2, '0');
            const t = `${pad(now.getHours())}:${pad(now.getMinutes())}:${pad(now.getSeconds())}`;
            const el1 = document.getElementById('clockDisplay');
            const el2 = document.getElementById('clockDisplayPulang');
            if (el1) el1.textContent = t;
            if (el2) el2.textContent = t;
        }
        setInterval(updateClock, 1000);
        updateClock();

        if (pekerjaanTextarea) {
            pekerjaanTextarea.addEventListener('input', function() {
                const length = this.value.length;
                if (charCount) charCount.textContent = length;
                if (charCount) charCount.classList.toggle('text-red-500', length > 500);
            });
        }

        function calculateHari() {
            if (tanggalInput.value) {
                const d = new Date(tanggalInput.value);
                if (!isNaN(d.getTime())) {
                    displayHari.value = hariNames[d.getDay()];
                    hariContainer.classList.remove('hidden');
                } else { hariContainer.classList.add('hidden'); }
            } else { hariContainer.classList.add('hidden'); }
        }

        function showMasukMode() {
            currentStatus = 'none';
            presensiForm.action = '/presensi-masuk';
            waktuMasukInfo.classList.remove('hidden');
            waktuPulangInfo.classList.add('hidden');
            pekerjaanSection.classList.add('hidden');
            fotoSection.classList.add('hidden');
            statusBadge.innerHTML = `<div class="flex items-center gap-2 px-4 py-2.5 bg-green-50 border border-green-200 rounded-xl">
                <span class="w-2 h-2 rounded-full bg-green-500 inline-block"></span>
                <span class="text-sm font-semibold text-green-700">Belum Presensi Masuk hari ini — silakan lanjutkan</span>
            </div>`;
            statusBadge.classList.remove('hidden');
            if (submitBtn) submitBtn.textContent = '✓ Simpan Presensi Masuk';
        }

        function showPulangMode(jamMasuk) {
            currentStatus = 'sudah_masuk';
            presensiForm.action = '/presensi-pulang';
            waktuMasukInfo.classList.add('hidden');
            waktuPulangInfo.classList.remove('hidden');
            pekerjaanSection.classList.remove('hidden');
            fotoSection.classList.remove('hidden');
            statusBadge.innerHTML = `<div class="flex items-center gap-2 px-4 py-2.5 bg-orange-50 border border-orange-200 rounded-xl">
                <span class="w-2 h-2 rounded-full bg-orange-500 inline-block"></span>
                <span class="text-sm font-semibold text-orange-700">Sudah Masuk pukul <strong>${jamMasuk}</strong> — silakan Presensi Pulang</span>
            </div>`;
            statusBadge.classList.remove('hidden');
            if (submitBtn) submitBtn.textContent = '✓ Simpan Presensi Pulang';
        }

        function showSudahPulangMode(jamMasuk, jamPulang) {
            currentStatus = 'sudah_pulang';
            waktuMasukInfo.classList.add('hidden');
            waktuPulangInfo.classList.add('hidden');
            pekerjaanSection.classList.add('hidden');
            fotoSection.classList.add('hidden');
            statusBadge.innerHTML = `<div class="flex items-center gap-2 px-4 py-2.5 bg-blue-50 border border-blue-200 rounded-xl">
                <span class="w-2 h-2 rounded-full bg-blue-500 inline-block"></span>
                <span class="text-sm font-semibold text-blue-700">Presensi hari ini selesai — Masuk ${jamMasuk} · Pulang ${jamPulang}</span>
            </div>`;
            statusBadge.classList.remove('hidden');
            if (submitBtn) { submitBtn.disabled = false; submitBtn.textContent = 'Simpan Presensi'; }
        }

        function resetFormSections() {
            waktuMasukInfo.classList.add('hidden');
            waktuPulangInfo.classList.add('hidden');
            pekerjaanSection.classList.add('hidden');
            fotoSection.classList.add('hidden');
            statusBadge.classList.add('hidden');
            statusInfo.classList.add('hidden');
            if (submitBtn) { submitBtn.disabled = false; submitBtn.textContent = 'Simpan Presensi'; }
        }

        async function checkStatus() {
            const karyawanId = karyawanSelect.value;
            const tanggal = tanggalInput.value;
            if (!karyawanId || !tanggal) { resetFormSections(); return; }

            statusInfo.classList.remove('hidden');
            statusLoading.classList.remove('hidden');
            statusBadge.classList.add('hidden');

            try {
                const res = await fetch(`/api/check-presensi?karyawanId=${karyawanId}&tanggal=${tanggal}`);
                const data = await res.json();
                statusLoading.classList.add('hidden');
                if (data.status === 'none') showMasukMode();
                else if (data.status === 'sudah_masuk') showPulangMode(data.jamMasuk);
                else if (data.status === 'sudah_pulang') showSudahPulangMode(data.jamMasuk, data.jamPulang);
            } catch (e) {
                statusLoading.classList.add('hidden');
                showMasukMode();
            }
        }

        karyawanSelect.addEventListener('change', checkStatus);
        tanggalInput.addEventListener('change', () => { calculateHari(); if (karyawanSelect.value) checkStatus(); });
        calculateHari();

        // Submit validation
        if (presensiForm) {
            presensiForm.addEventListener('submit', function(e) {
                // Blokir jika sudah pulang
                if (currentStatus === 'sudah_pulang') {
                    e.preventDefault();
                    showAlertModal(
                        'Presensi Sudah Selesai',
                        'Anda sudah melakukan Presensi Masuk dan Presensi Pulang hari ini.\nSilakan kembali lagi besok!',
                        'info'
                    );
                    return;
                }
                const isPulang = presensiForm.action.includes('/presensi-pulang');
                if (isPulang) {
                    const pekVal = pekerjaanTextarea ? pekerjaanTextarea.value.trim() : '';
                    const fotoVal = document.getElementById('fotoInput') ? document.getElementById('fotoInput').value : '';
                    if (!pekVal) {
                        e.preventDefault();
                        showAlertModal('Deskripsi Pekerjaan Kosong', 'Mohon isi deskripsi pekerjaan sebelum menyimpan Presensi Pulang.', 'warning');
                        return;
                    }
                    if (!fotoVal) {
                        e.preventDefault();
                        showAlertModal('Foto Belum Diambil', 'Mohon ambil foto selfie sebagai bukti kehadiran sebelum menyimpan Presensi Pulang.', 'warning');
                        return;
                    }
                }
                stopCamera();
            });
        }

        // --- CAMERA INTEGRATION CODE ---
        const startCameraBtn = document.getElementById('startCameraBtn');
        const captureBtn = document.getElementById('captureBtn');
        const retakeBtn = document.getElementById('retakeBtn');
        const video = document.getElementById('video');
        const canvas = document.getElementById('canvas');
        const photoPreview = document.getElementById('photoPreview');
        const fotoInput = document.getElementById('fotoInput');
        const cameraPlaceholder = document.getElementById('cameraPlaceholder');
        const cameraControls = document.getElementById('cameraControls');
        const postCaptureControls = document.getElementById('postCaptureControls');
        const cameraContainer = document.getElementById('cameraContainer');
        const cameraFallbackInput = document.getElementById('cameraFallbackInput');

        // Check if webcam camera is supported & in secure context
        const isSecure = window.isSecureContext || (window.location.protocol === 'https:' || window.location.hostname === 'localhost' || window.location.hostname === '127.0.0.1');
        const canUseWebcam = !!(navigator.mediaDevices && navigator.mediaDevices.getUserMedia) && isSecure;

        if (!canUseWebcam) {
            // Update UI/button for hybrid fallback (mobile native camera)
            if (startCameraBtn) {
                startCameraBtn.innerHTML = `
                    <svg class="w-4 h-4 mr-1.5 inline-block" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
                    Buka Kamera HP
                `;
            }
            const descText = document.querySelector('#cameraPlaceholder + p') || document.querySelector('.form-group p.text-muted');
            if (descText) {
                descText.textContent = 'Klik tombol di bawah untuk mengambil foto selfie/kehadiran langsung menggunakan kamera HP Anda.';
            }
        }

        let cameraStream = null;

        async function startCamera() {
            if (!canUseWebcam) {
                // Non-secure context / Safari or Chrome on iOS sandbox -> Fallback to native system camera
                if (cameraFallbackInput) {
                    cameraFallbackInput.click();
                }
                return;
            }

            try {
                // Clear any existing stream
                stopCamera();

                cameraStream = await navigator.mediaDevices.getUserMedia({
                    video: {
                        facingMode: 'user',
                        width: { ideal: 640 },
                        height: { ideal: 480 }
                    },
                    audio: false
                });

                video.srcObject = cameraStream;
                video.classList.remove('hidden');
                cameraPlaceholder.classList.add('hidden');
                photoPreview.classList.add('hidden');
                cameraControls.classList.remove('hidden');
                postCaptureControls.classList.add('hidden');
                
                // Clear the hidden input
                fotoInput.value = '';
            } catch (error) {
                console.error('Camera access error:', error);
                
                // Fallback automatically if browser webcam fails
                if (cameraFallbackInput) {
                    cameraFallbackInput.click();
                }
            }
        }

        function stopCamera() {
            if (cameraStream) {
                cameraStream.getTracks().forEach(track => track.stop());
                cameraStream = null;
            }
        }

        if (startCameraBtn) {
            startCameraBtn.addEventListener('click', startCamera);
        }

        if (cameraFallbackInput) {
            cameraFallbackInput.addEventListener('change', function(e) {
                const file = e.target.files[0];
                if (!file) return;

                const reader = new FileReader();
                reader.onload = function(event) {
                    const img = new Image();
                    img.onload = function() {
                        // Draw to canvas to compress & standardize dimensions
                        const maxW = 640;
                        const maxH = 480;
                        let w = img.width;
                        let h = img.height;

                        if (w > maxW || h > maxH) {
                            const ratio = Math.min(maxW / w, maxH / h);
                            w = Math.round(w * ratio);
                            h = Math.round(h * ratio);
                        }

                        canvas.width = w;
                        canvas.height = h;
                        const ctx = canvas.getContext('2d');
                        
                        // Scale and draw normally (static photo does not need mirroring)
                        ctx.drawImage(img, 0, 0, w, h);

                        // Compress & ensure it is well below 1MB
                        let quality = 0.8;
                        let dataUrl = canvas.toDataURL('image/jpeg', quality);
                        while (dataUrl.length * 0.75 > 900 * 1024 && quality > 0.1) {
                            quality -= 0.1;
                            dataUrl = canvas.toDataURL('image/jpeg', quality);
                        }
                        fotoInput.value = dataUrl;

                        // Show preview
                        photoPreview.src = dataUrl;
                        photoPreview.classList.remove('hidden');
                        
                        cameraPlaceholder.classList.add('hidden');
                        video.classList.add('hidden');
                        cameraControls.classList.add('hidden');
                        postCaptureControls.classList.remove('hidden');
                    };
                    img.src = event.target.result;
                };
                reader.readAsDataURL(file);
            });
        }

        if (captureBtn) {
            captureBtn.addEventListener('click', function() {
                if (!video.srcObject) return;

                // Match canvas dimensions to video
                canvas.width = video.videoWidth || 640;
                canvas.height = video.videoHeight || 480;

                const ctx = canvas.getContext('2d');
                // Mirror image for front camera selfie feel
                ctx.translate(canvas.width, 0);
                ctx.scale(-1, 1);
                
                ctx.drawImage(video, 0, 0, canvas.width, canvas.height);

                // Compress & ensure it is well below 1MB
                let quality = 0.8;
                let dataUrl = canvas.toDataURL('image/jpeg', quality);
                while (dataUrl.length * 0.75 > 900 * 1024 && quality > 0.1) {
                    quality -= 0.1;
                    dataUrl = canvas.toDataURL('image/jpeg', quality);
                }
                fotoInput.value = dataUrl;

                // Show preview
                photoPreview.src = dataUrl;
                photoPreview.classList.remove('hidden');
                
                // Hide video & controls
                video.classList.add('hidden');
                cameraControls.classList.add('hidden');
                postCaptureControls.classList.remove('hidden');

                // Turn off camera stream
                stopCamera();
            });
        }

        if (retakeBtn) {
            retakeBtn.addEventListener('click', function() {
                fotoInput.value = '';
                photoPreview.classList.add('hidden');
                photoPreview.src = '';
                if (cameraFallbackInput) {
                    cameraFallbackInput.value = '';
                }
                startCamera();
            });
        }

        // (stopCamera is called in submit handler above)
    </script>

    <!-- Custom Alert Modal -->
    <div id="alertModal" class="fixed inset-0 bg-black/50 z-50 flex items-center justify-center p-4 hidden opacity-0 transition-opacity duration-200">
        <div id="alertModalContent" class="bg-card rounded-2xl p-6 max-w-sm w-full shadow-xl transform scale-95 transition-transform duration-200">
            <div class="flex flex-col items-center text-center gap-4">
                <!-- Icon -->
                <div id="alertModalIcon" class="w-14 h-14 rounded-full flex items-center justify-center flex-shrink-0"></div>
                <!-- Text -->
                <div>
                    <h3 id="alertModalTitle" class="font-display text-lg font-bold text-fg mb-1"></h3>
                    <p id="alertModalMessage" class="text-sm text-muted whitespace-pre-line leading-relaxed"></p>
                </div>
                <!-- Button -->
                <button type="button" onclick="closeAlertModal()" id="alertModalBtn" class="w-full px-6 py-2.5 bg-accent text-white font-semibold rounded-xl hover:bg-accentHover transition-colors btn-press text-sm">
                    Mengerti
                </button>
            </div>
        </div>
    </div>

    <script>
        const alertModal = document.getElementById('alertModal');
        const alertModalContent = document.getElementById('alertModalContent');

        function showAlertModal(title, message, type = 'info') {
            const iconEl = document.getElementById('alertModalIcon');
            const titleEl = document.getElementById('alertModalTitle');
            const msgEl = document.getElementById('alertModalMessage');
            const btnEl = document.getElementById('alertModalBtn');

            titleEl.textContent = title;
            msgEl.textContent = message;

            const configs = {
                info: {
                    bg: 'bg-red-100', iconColor: 'text-red-600', btnClass: 'bg-accent hover:bg-accentHover',
                    icon: `<svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>`
                },
                warning: {
                    bg: 'bg-red-100', iconColor: 'text-red-600', btnClass: 'bg-accent hover:bg-accentHover',
                    icon: `<svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>`
                },
                error: {
                    bg: 'bg-red-100', iconColor: 'text-red-600', btnClass: 'bg-accent hover:bg-accentHover',
                    icon: `<svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>`
                }
            };
            const cfg = configs[type] || configs.info;
            iconEl.className = `w-14 h-14 rounded-full flex items-center justify-center flex-shrink-0 ${cfg.bg} ${cfg.iconColor}`;
            iconEl.innerHTML = cfg.icon;
            btnEl.className = `w-full px-6 py-2.5 text-white font-semibold rounded-xl transition-colors btn-press text-sm ${cfg.btnClass}`;

            alertModal.classList.remove('hidden');
            setTimeout(() => {
                alertModal.classList.remove('opacity-0');
                alertModalContent.classList.remove('scale-95');
            }, 10);
        }

        function closeAlertModal() {
            alertModal.classList.add('opacity-0');
            alertModalContent.classList.add('scale-95');
            setTimeout(() => alertModal.classList.add('hidden'), 200);
        }

        // Tutup modal jika klik backdrop
        alertModal.addEventListener('click', function(e) {
            if (e.target === alertModal) closeAlertModal();
        });
    </script>
</body>
</html>
