<!-- Footer -->
<footer class="bg-card border-t border-border mt-auto  transition-all duration-300">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col md:flex-row items-center justify-between gap-4">

        <!-- Left side: App Info & Copyright -->
        <div class="flex flex-col sm:flex-row items-center gap-2 sm:gap-3 text-sm text-muted text-center md:text-left">
            <div class="flex items-center gap-2">
                <img src="/logo_typography.png" alt="HITAM Logo" class="h-auto w-32">
            </div>
            <span class="hidden sm:inline text-border">|</span>
            <span>&copy; <%= new Date().getFullYear() %> Presensi PuTI. Hak Cipta Dilindungi.</span>
        </div>

        <!-- Right side: Git Versioning -->
        <div class="flex flex-wrap items-center justify-center md:justify-end gap-2.5 text-xs">
            <% if (locals.gitInfo) { %>
                <!-- Version Badge -->
                <span
                    class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-inputBg border border-border text-fg font-mono font-semibold"
                    title="Versi Aplikasi">
                    <span class="w-1.5 h-1.5 rounded-full bg-success"></span>
                    v<%= gitInfo.version %>
                </span>
                <% } %>
        </div>
    </div>
</footer>
</body>

</html>