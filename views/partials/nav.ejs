    <script>
        const options = { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' };
        const dateStr = new Date().toLocaleDateString('id-ID', options);
        if (document.getElementById('currentDateDesktop')) {
            document.getElementById('currentDateDesktop').textContent = dateStr;
        }
        if (document.getElementById('currentDateMobile')) {
            const optionsMobile = { weekday: 'short', day: 'numeric', month: 'short' };
            document.getElementById('currentDateMobile').textContent = new Date().toLocaleDateString('id-ID', optionsMobile);
        }
    </script>
