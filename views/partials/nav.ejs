                    <a href="/" class="nav-item <%= path === '/' ? 'active text-fg' : 'text-muted' %> px-4 py-2 text-sm font-medium rounded-xl hover:bg-inputBg transition-all btn-press whitespace-nowrap">
                        Presensi
                    </a>
                    <a href="/daftar-kehadiran" class="nav-item <%= path === '/daftar-kehadiran' ? 'active text-fg' : 'text-muted' %> px-4 py-2 text-sm font-medium rounded-xl hover:bg-inputBg transition-all btn-press whitespace-nowrap">
                        Daftar Kehadiran
                    </a>
                    <a href="/riwayat-bulanan" class="nav-item <%= path.startsWith('/riwayat-bulanan') || path.startsWith('/detail-bulanan') ? 'active text-fg' : 'text-muted' %> px-4 py-2 text-sm font-medium rounded-xl hover:bg-inputBg transition-all btn-press whitespace-nowrap">
